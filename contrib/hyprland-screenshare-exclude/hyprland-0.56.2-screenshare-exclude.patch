 }
 
+void CGLFramebuffer::setMirrorWrite(bool enabled) {
+    if (!m_fbAllocated || !m_mirrorTex)
+        return;
+
+    GLint prev = 0;
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &prev);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_fb);
+    const GLenum drawBuffers[] = {GL_COLOR_ATTACHMENT0, enabled ? GL_COLOR_ATTACHMENT1 : GL_NONE};
+    glDrawBuffers(2, drawBuffers);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, sc<GLuint>(prev));
+}
+
 void CGLFramebuffer::unbind() {
     glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
 }
