#!/bin/bash

# omarchy:summary=Record the webcam into a recording bundle as its own stream
# omarchy:group=capture
# omarchy:args=start <bundle-dir> [--device=<dev>] [--size=<small|medium|large>] [--shape=<circle|rounded|rect>] [--self-view=<yes|no>] [--outside=<WxH+X+Y>] [--rect=<WxH+X+Y>] [--exclude=<yes|no>] | stop | status
# omarchy:hidden=true
#
# One ffmpeg process opens the camera ONCE and fans it out: cam.mp4 for the editor,
# cam.tsv (mkvtimestamp_v2) as a per-frame CLOCK_REALTIME track, and -- when a self-view
# is wanted -- a copy of the camera's native MJPEG to a FIFO that mpv displays with no
# re-encode.
#
# Three details are non-negotiable, each having failed the other way:
#   * the preview branch goes through ffmpeg's `fifo` pseudo-muxer. Piped directly, a
#     dying preview truncated a 10-second recording to 3.4 seconds.
#   * the FIFO is read by `cat fifo | mpv fd://0`; mpv cannot open a FIFO itself.
#   * -copyts is global. It cannot be applied to one output, so the whole command wears
#     it, which is what puts true wallclock in cam.tsv.
#
# The camera is NOT burned into the screen here -- that is the --burn-in path in
# omarchy-capture-screenrecording. This stream stays separate so the editor can move,
# resize or remove it afterwards.

set -uo pipefail

# A private runtime directory, never bare /tmp.
#
# `${XDG_RUNTIME_DIR:-/tmp}` put every state file this program owns -- including the
# supervisor's process set, whose (pid, start time) pairs are TRUSTED and signalled --
# into a world-writable directory whenever the variable was unset. XDG_RUNTIME_DIR is
# 0700 and per-user; the fallback is made to match rather than to be convenient. It is
# created 0700 and refused if it already exists owned by anyone else.
omarchy_runtime_dir() {
  if [[ -n ${XDG_RUNTIME_DIR:-} && -d $XDG_RUNTIME_DIR ]]; then
    printf '%s' "$XDG_RUNTIME_DIR"
    return 0
  fi
  local fallback="/tmp/omarchy-studio-$(id -u)"
  mkdir -p -m 700 "$fallback" 2>/dev/null
  if [[ -d $fallback && -O $fallback ]]; then
    chmod 700 "$fallback" 2>/dev/null
    printf '%s' "$fallback"
    return 0
  fi
  # Someone else owns it: fall back to a fresh private directory rather than sharing.
  mktemp -d "/tmp/omarchy-studio-XXXXXX"
}

RUNTIME_DIR="$(omarchy_runtime_dir)"
PID_FILE="$RUNTIME_DIR/omarchy-studio-camera.pid"
PREVIEW_PID_FILE="$RUNTIME_DIR/omarchy-studio-camera-preview.pid"
FIFO="$RUNTIME_DIR/omarchy-studio-camera.fifo"
LOG_FILE="$RUNTIME_DIR/omarchy-studio-camera.log"
# start and stop mutate the same processes, and stop is deliberately called from two
# places at once: the recorder's stop path, and the detached watchdog that fires when
# gsr exits. Unserialized, both found the same live ffmpeg and both sent it SIGINT --
# and a SECOND signal is not a second polite request, it is ffmpeg's "Immediate exit"
# path, which abandons the mp4 trailer. The symptom was a cam.mp4 with no moov atom
# (unreadable by ffprobe, so finalize could not complete capture.json) beside a
# perfectly good screen.mp4. Verified in the wild on 2026-09-02_19-10-25.
LOCK_FILE="$RUNTIME_DIR/omarchy-studio-camera.lock"

readonly MARGIN=40
readonly SELF_VIEW_MARKER="omarchy_studio_selfview=1"
# The radius `rounded` uses, as hundredths of the window's side. Derived from
# layers.SQUIRCLE_N (the real Lamé exponent, 4) in shape_self_view's comment -- the live
# bubble approximates that curve with an ordinary arc, because Hyprland's rounding_power
# chamfers rather than curves at the radius the true shape would need.
readonly ROUNDED_RADIUS_PCT=27
# The self-view's window title. WebcamOverlay is the burn-in overlay's title and must
# stay visible to the capture; the excluded self-view needs a title of its own because
# the no_screen_share rule is matched on it and a dynamic rule, once added, is permanent
# for the life of the compositor.
SELF_VIEW_TITLE="WebcamOverlay"
readonly EXCLUDED_SELF_VIEW_TITLE="WebcamSelfView"

DEVICE=""
SIZE="medium"
# The shape the setup bar was left on, in the one vocabulary everything uses now. The
# self-view is masked to it by the compositor so that what is on screen while you record
# is the shape the editor and the export will draw -- see shape_self_view().
SHAPE="circle"
SELF_VIEW="no"
OUTSIDE=""
REQUEST_RECT=""
# --exclude=yes: the recorder is on the portal backend and the compositor keeps a
# no_screen_share window out of its frames, so the self-view may sit INSIDE the capture.
EXCLUDE="no"
# Empty means "the best frame rate the device offers at the mode we chose". It was 30,
# which silently halved a 60fps camera and, worse, ASKED a 30fps-max camera for a rate
# it does not have.
FPS=""
CAM_FPS=30
# nv12 or mjpeg, whichever resolve_capture_format finds is best on the device.
CAM_PIXFMT="mjpeg"

usage() {
  echo "Usage: omarchy-capture-camera start <bundle-dir> [--device=<dev>] [--size=<small|medium|large>] [--shape=<circle|rounded|rect>] [--self-view=<yes|no>] [--outside=<WxH+X+Y>] [--rect=<WxH+X+Y>] [--exclude=<yes|no>]" >&2
  echo "       omarchy-capture-camera stop|status" >&2
  exit 1
}

# Lua form first, legacy dispatch second: the string forms are dead under Omarchy's Lua
# parser on current builds, and the Lua form is missing on older ones.
hypr_dispatch() {
  local lua="$1"
  shift
  hyprctl dispatch "$lua" >/dev/null 2>&1 || hyprctl dispatch "$@" >/dev/null 2>&1
}

alive() {
  local pid=${1:-}
  [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null
}

resolve_device() {
  [[ -n $DEVICE ]] && return 0
  DEVICE=$(omarchy-capture-webcam-list | sed -n '1s/[[:space:]].*//p')
  [[ -n $DEVICE ]]
}

# The fan-out copies the camera's native MJPEG to the preview branch, so an MJPEG mode
# is required rather than preferred: without one the preview would have to be re-encoded
# and the zero-copy branch is the reason the self-view is free.
#
# THE BEST MODE THE DEVICE OFFERS, not the first one off a wishlist. This used to walk
# `1280x720 640x480 1920x1080` and take the first match, which meant every camera that
# could do 720p recorded at 720p -- including one that also offered 1080p and 1664x1248,
# and including any 4K camera you might plug in later. The list could not be reordered
# to fix it either: putting 1920x1080 first would have penalised a camera whose only
# 1080p mode ran at 5fps. Sorting by pixels and then by frame rate answers both.
# NV12 AND MJPEG, preferring NV12 at equal size and rate.
#
# This used to demand MJPEG, because the self-view branch copied the camera's native
# MJPEG to mpv without re-encoding. That reason is gone -- the preview is scaled on the
# GPU and re-encoded small -- and the requirement had become the expensive option.
# Measured on a 3840x2160 camera, 300 frames against 10.0s of real time:
#
#   MJPEG in:  12.2s   (a JPEG decode plus a yuvj422p -> nv12 swscale, both on the CPU)
#   NV12 in:   10.4s   (neither; the encoder wants nv12 and the camera already speaks it)
#
# Taking 12.2s to produce 10s of frames is a 22% deficit, and a deficit does not show up
# as dropped frames -- it shows up as a backlog that GROWS, which is why the self-view
# ended up "a solid 3-6 seconds behind real time" and getting worse the longer it ran.
#
# It costs USB bandwidth instead (4K30 nv12 is ~370 MB/s uncompressed), but a camera only
# advertises a mode it can deliver over the link it is attached to, so trusting the
# descriptors is the right call. MJPEG stays for the many cameras that offer nothing
# else, where the decode is cheap anyway.
# Can this machine encode with VAAPI at all?
#
# On Apple silicon under Linux, no: there is no libva driver for the GPU (no
# asahi_drv_video.so, only virtio_gpu's), no Vulkan VK_KHR_video_encode_queue, no V4L2
# M2M encoder, and apple_avd is a stateless DECODER whose firmware does not even load.
# So /dev/dri/renderD128 opens and then every h264_vaapi encode fails, taking the whole
# filtergraph with it -- hwupload and scale_vaapi are just as unavailable as the encoder.
#
# The screen side already meets this and already solves it: the recorder passes
# gpu-screen-recorder -fallback-cpu-encoding yes, which is the only reason a screen
# capture works on such a machine at all. The camera was simply the one path that never
# got the same treatment.
#
# Probed rather than assumed -- a 64x64 lavfi frame straight through the real encoder,
# about 23ms -- because "which machine has VAAPI" is not something to hardcode.
vaapi_encode_available() {
  [[ -n ${VAAPI_ENCODE_OK:-} ]] || {
    if ffmpeg -v error -init_hw_device vaapi=va:/dev/dri/renderD128 \
      -f lavfi -i color=size=64x64:rate=1 -frames:v 1 \
      -vf format=nv12,hwupload -c:v h264_vaapi -f null - >/dev/null 2>&1; then
      VAAPI_ENCODE_OK=yes
    else
      VAAPI_ENCODE_OK=no
    fi
  }
  [[ $VAAPI_ENCODE_OK == "yes" ]]
}

resolve_capture_format() {
  local formats best
  formats=$(v4l2-ctl --list-formats-ext -d "$DEVICE" 2>/dev/null)

  # One "pixels pref width height fps fmt" row per (usable size, interval) pair. Stepwise
  # and continuous sizes are skipped -- they have no enumerated modes to compare, and
  # every UVC webcam publishes discrete ones alongside them. `pref` breaks ties to nv12.
  #
  # -k3,3nr (wider first) is the LAST key and it matters: a device can publish the same
  # mode in both orientations -- Apple's ISP offers 1920x1440 AND 1440x1920, identical
  # area, identical rate, both nv12 -- and with every key tied, GNU sort falls back to
  # comparing whole lines, which put the PORTRAIT one first. That is the wrong shape for
  # a camera bubble and the more expensive encode. UVC webcams never publish portrait
  # modes, so nothing caught this until the ISP on an Apple machine did.
  best=$(awk '
    /^[[:space:]]*\[[0-9]+\]/ {
      fmt = ($0 ~ /MJPG/) ? "mjpeg" : (($0 ~ /NV12/) ? "nv12" : "")
      w = 0
    }
    fmt != "" && /Size: Discrete/   { split($3, d, "x"); w = d[1] + 0; h = d[2] + 0 }
    fmt != "" && /Interval: Discrete/ && w > 0 {
      f = $0; sub(/.*\(/, "", f); sub(/[[:space:]]*fps\).*/, "", f)
      printf "%d %d %d %d %d %s\n", w * h, (fmt == "nv12" ? 1 : 0), w, h, f + 0, fmt
    }
  ' <<<"$formats" | sort -k1,1nr -k5,5nr -k2,2nr -k3,3nr | head -1)

  [[ -n $best ]] || return 1
  read -r _ _ CAM_WIDTH CAM_HEIGHT CAM_FPS CAM_PIXFMT <<<"$best"
  [[ ${CAM_WIDTH:-0} -gt 0 && ${CAM_HEIGHT:-0} -gt 0 ]] || return 1
  ((CAM_FPS > 0)) || CAM_FPS=30
  # An explicit --fps is a deliberate override and outranks the device's opinion.
  [[ -n $FPS ]] && CAM_FPS=$FPS
  return 0
}

# Bits per second for the camera encode, scaled from the 6 Mbit that was tuned at
# 1280x720. A fixed 6M was thin the moment the capture stopped being 720p, and the
# camera is the one stream a viewer looks straight at. Clamped at both ends: below 4M
# even a small camera goes blocky on motion, and above 40M the file grows faster than
# any visible gain -- 4K30 asks for 54M by the linear rule and does not need it.
# 0.217 bits per pixel per frame is what the old flat 6M worked out to at 1280x720@30,
# so the baseline reproduces itself (5.99 -> 5M) and everything else scales off a number
# that was actually tuned rather than invented. /1e9 because the answer is in MEGAbits:
# the intermediate is ~1.4e10 for a 4K mode, which is why this is 64-bit arithmetic.
# The camera is composited into a bubble a few hundred pixels across, so a 4K sensor
# mode is not headroom -- it is 8.3M pixels encoded per frame, and shared with the
# screen encode on one iGPU, to fill a circle that is at most a third of the canvas.
# 1440 is still generous (a 30%-height bubble on a 5K canvas is 864px) and cuts the
# work to 2.6M pixels.
#
# HONESTY ABOUT WHAT THIS DOES AND DOES NOT FIX. It was written while chasing a
# self-view that ran seconds behind, and it is NOT established that it cures that.
# Measured on this machine, 3840x2160@30 NV12 with both branches live: 300 frames took
# 10.5s of wall time and 600 took 20.5s -- a CONSTANT half second of startup, not a
# growing deficit, so the pipeline does keep up at 4K. mpv also kept up as a consumer,
# alone and under a competing 5K screen encode, with zero queue overflows in either.
# The cap is kept because encoding 4K for a 360px bubble is waste on any reading; it is
# not kept because it was proven to fix the latency.
CAM_RECORD_MAX_H=${OMARCHY_CAMERA_MAX_HEIGHT:-1440}

# The height actually encoded, after that cap.
camera_encode_height() {
  if ((CAM_HEIGHT > CAM_RECORD_MAX_H)); then echo "$CAM_RECORD_MAX_H"; else echo "$CAM_HEIGHT"; fi
}

camera_bitrate() {
  local h w
  h=$(camera_encode_height)
  w=$((CAM_WIDTH * h / CAM_HEIGHT))
  local bps=$((w * h * CAM_FPS * 217 / 1000000000))
  ((bps < 4)) && bps=4
  ((bps > 40)) && bps=40
  echo "${bps}M"
}

monitors_logical() {
  hyprctl monitors -j | jq -r '
    .[] | .transform as $t |
    [ .name, .x, .y,
      (if $t == 1 or $t == 3 then (.height / .scale | floor) else (.width / .scale | floor) end),
      (if $t == 1 or $t == 3 then (.width / .scale | floor) else (.height / .scale | floor) end)
    ] | @tsv'
}

rects_overlap() {
  local ax=$1 ay=$2 aw=$3 ah=$4 bx=$5 by=$6 bw=$7 bh=$8
  ((ax < bx + bw && bx < ax + aw && ay < by + bh && by < ay + ah))
}

# The 8:9 portrait presets from default/hypr/apps/webcam-overlay.lua, scaled from the
# host monitor's height so the self-view is the same share of a 1080p and a 6K display.
# SQUARE, like the self-view in the setup window and like WebcamSettings.placement for
# every shape but `rect`. It was 16:18 portrait -- 320x360 at medium -- against a 4:3
# camera, so mpv letterboxed the picture into it and the bubble on screen was a black
# box with a strip of face in the middle. Nothing else was ever square-shaped about it:
# a circle in a 320x360 window is an ellipse.
preset_size() {
  local monitor_height=$1
  case $SIZE in
  small) PRESET_W=$((monitor_height * 4 / 25)) ;;
  large) PRESET_W=$((monitor_height * 3 / 10)) ;;
  *) PRESET_W=$((monitor_height * 2 / 9)) ;;
  esac
  PRESET_H=$PRESET_W
}

# Puts the self-view exactly where the user left it in the setup bar.
#
# WHY THIS EXISTS. The pre-record self-view can be dragged anywhere and resized by its
# grip, and that rectangle is what the export composites the camera into. The live
# bubble ignored it and park-spotted to a corner at a preset size, so pressing Record
# threw away the placement the user had just made -- on screen, mid-take, every time.
#
# Only callable when the compositor is hiding the bubble from the capture. On KMS
# nothing can, so an honoured rect would be a bubble welded into the frames; that case
# still parks, and the export still puts the camera where the user asked.
place_at_rect() {
  [[ $REQUEST_RECT =~ ^([0-9]+)x([0-9]+)\+(-?[0-9]+)\+(-?[0-9]+)$ ]] || return 1
  local rw=${BASH_REMATCH[1]} rh=${BASH_REMATCH[2]} rx=${BASH_REMATCH[3]} ry=${BASH_REMATCH[4]}
  ((rw > 0 && rh > 0)) || return 1

  # The monitor under the bubble's CENTRE: `move` in the window rule is relative to the
  # window's own monitor, and a bubble straddling an edge belongs to the display showing
  # most of it.
  local cx=$((rx + rw / 2)) cy=$((ry + rh / 2))
  local mname mx my mw mh
  while IFS=$'\t' read -r mname mx my mw mh; do
    ((cx >= mx && cx < mx + mw && cy >= my && cy < my + mh)) || continue
    PRESET_W=$rw PRESET_H=$rh
    PARK_X=$rx PARK_Y=$ry
    PARK_MON=$mname PARK_MX=$mx PARK_MY=$my
    return 0
  done < <(monitors_logical)
  return 1
}

# Finds a spot for the self-view that the capture cannot see. Leaves it in PARK_X/PARK_Y
# (plus PRESET_W/PRESET_H) and returns 1 when there is nowhere to put it. Nothing hides a
# window from the KMS capture, so "nowhere" means no self-view rather than a self-view in
# the recording -- unless --exclude=yes, when the compositor hides it from the portal
# and it is parked inside the capture instead.
find_park_spot() {
  local ex_w=0 ex_h=0 ex_x=0 ex_y=0
  if [[ $OUTSIDE =~ ^([0-9]+)x([0-9]+)\+(-?[0-9]+)\+(-?[0-9]+)$ ]]; then
    ex_w=${BASH_REMATCH[1]}
    ex_h=${BASH_REMATCH[2]}
    ex_x=${BASH_REMATCH[3]}
    ex_y=${BASH_REMATCH[4]}
  else
    return 1
  fi

  local mx my mw mh

  # A gap on the captured monitor first: the user is looking at that screen, and a
  # self-view on a display they are not facing is not a self-view.
  while IFS=$'\t' read -r mname mx my mw mh; do
    rects_overlap "$ex_x" "$ex_y" "$ex_w" "$ex_h" "$mx" "$my" "$mw" "$mh" || continue
    preset_size "$mh"

    local right_edge=$((ex_x + ex_w)) bottom_edge=$((ex_y + ex_h))
    if ((mx + mw - right_edge >= PRESET_W + 2 * MARGIN)); then
      PARK_X=$((mx + mw - PRESET_W - MARGIN))
      PARK_Y=$((my + mh - PRESET_H - MARGIN))
      PARK_MON=$mname PARK_MX=$mx PARK_MY=$my
      return 0
    fi
    if ((ex_x - mx >= PRESET_W + 2 * MARGIN)); then
      PARK_X=$((mx + MARGIN))
      PARK_Y=$((my + mh - PRESET_H - MARGIN))
      PARK_MON=$mname PARK_MX=$mx PARK_MY=$my
      return 0
    fi
    if ((my + mh - bottom_edge >= PRESET_H + 2 * MARGIN)); then
      PARK_X=$((mx + mw - PRESET_W - MARGIN))
      PARK_Y=$((my + mh - PRESET_H - MARGIN))
      PARK_MON=$mname PARK_MX=$mx PARK_MY=$my
      return 0
    fi
    if ((ex_y - my >= PRESET_H + 2 * MARGIN)); then
      PARK_X=$((mx + mw - PRESET_W - MARGIN))
      PARK_Y=$((my + MARGIN))
      PARK_MON=$mname PARK_MX=$mx PARK_MY=$my
      return 0
    fi
  done < <(monitors_logical)

  # Otherwise any monitor the capture does not cover at all.
  while IFS=$'\t' read -r mname mx my mw mh; do
    rects_overlap "$ex_x" "$ex_y" "$ex_w" "$ex_h" "$mx" "$my" "$mw" "$mh" && continue
    preset_size "$mh"
    PARK_X=$((mx + mw - PRESET_W - MARGIN))
    PARK_Y=$((my + mh - PRESET_H - MARGIN))
    PARK_MON=$mname PARK_MX=$mx PARK_MY=$my
    return 0
  done < <(monitors_logical)

  # Nowhere outside the capture. Excluded, it goes inside: bottom-right of the captured
  # rectangle, sized for the monitor under that corner. The user can drag it anywhere
  # afterwards -- the exclusion follows the window, not the spot.
  [[ $EXCLUDE == "yes" ]] || return 1
  local cx=$((ex_x + ex_w - 1)) cy=$((ex_y + ex_h - 1))
  while IFS=$'\t' read -r mname mx my mw mh; do
    ((cx >= mx && cx < mx + mw && cy >= my && cy < my + mh)) || continue
    preset_size "$mh"
    PARK_X=$((ex_x + ex_w - PRESET_W - MARGIN))
    PARK_Y=$((ex_y + ex_h - PRESET_H - MARGIN))
    PARK_MON=$mname PARK_MX=$mx PARK_MY=$my
    return 0
  done < <(monitors_logical)

  return 1
}

# Applied on EVERY start, not once per compositor instance. A dynamic rule survives
# until the next config reload -- and Hyprland reloads its config on plugin loads
# (hyprpm reload), theme switches and `hyprctl reload`, silently dropping every rule
# added with hyprctl eval. A once-per-instance stamp outlived the rule, the preview
# mapped un-ruled (tiled, full screen for a blink), the check below saw no_screen_share
# missing and closed it mid-take. Re-adding a rule is harmless (the newest one wins); the
# stamp was not. launch_preview still verifies the rule actually landed on the window.
# hyprctl eval with hl.* is the only form that works under Omarchy's Lua config.
apply_self_view_rule() {
  # no_anim, not animation = "none": the string picks a style, the bool makes Hyprland
  # skip the close-fade SNAPSHOT entirely. A fadeout snapshot is not masked out of the
  # screenshare mirror, so without this, closing the bubble mid-take can flash it into
  # the recording on the way out.
  #
  # monitor/move/size are in the rule so the window MAPS at the park spot, at its final
  # size. Without them a floating window maps dead-centre and the dispatches below then
  # drag it to the corner in plain view -- a jerk on every take, right after the
  # countdown. `move` is relative to the window's monitor, which is why the rule also
  # pins the monitor (a new window otherwise opens on the focused one).
  hyprctl eval 'hl.window_rule({ match = { title = "^'"$EXCLUDED_SELF_VIEW_TITLE"'$" }, float = true, pin = true, monitor = "'"$PARK_MON"'", move = "'"$((PARK_X - PARK_MX)) $((PARK_Y - PARK_MY))"'", size = "'"$PRESET_W $PRESET_H"'", no_screen_share = true, no_anim = true })' >/dev/null 2>&1
}

# The self-view is an mpv window, and mpv cannot mask itself into a circle. The
# compositor can: Hyprland rounds window corners, so a SQUARE window with the radius at
# half its side is a circle, and no radius at all is `rect`.
#
# `rounded` IS APPROXIMATED, and deliberately. It means the Lamé n=4 superellipse
# everywhere else (layers._squircle_mask, SquircleShape.qml), and Hyprland's
# `rounding_power` is nominally that exponent -- but at a radius of half the side, power
# 4 does not curve, it CHAMFERS: photographed, it comes out as a circle with flats cut
# across it, which is what got reported as "some weird octagon shape". So this uses an
# ordinary power-2 arc at the radius that best matches the real superellipse instead.
#
# 0.27 of the side, from the geometry rather than by eye: the n=4 superellipse crosses
# the 45-degree diagonal at 0.4204 of the half-side (a circle crosses at 0.3536, a square
# at 0.5), and a rounded rect matches that at r = 0.272. Close enough that the live
# bubble and the exported one read as the same shape; the export still draws the true
# curve.
#
# set_prop, not a window rule: hl.window_rule has no rounding field (only the boolean
# no_rounding), and a dynamic rule cannot be removed for the life of the compositor
# anyway -- so a rule would freeze the first recording's shape onto every later one.
shape_self_view() {
  local window=$1 rounding power
  case $SHAPE in
  rect) rounding=0 power=2 ;;
  circle) rounding=$((PRESET_W / 2)) power=2 ;;
  *) rounding=$((PRESET_W * ROUNDED_RADIUS_PCT / 100)) power=2 ;;
  esac
  hypr_dispatch \
    "hl.dsp.window.set_prop({ prop = 'rounding', value = $rounding, window = \"$window\" })" \
    setprop "$window rounding $rounding"
  hypr_dispatch \
    "hl.dsp.window.set_prop({ prop = 'rounding_power', value = $power, window = \"$window\" })" \
    setprop "$window rounding_power $power"
}

start_preview() {
  # The user's own placement wins wherever it can be honoured. It cannot be on KMS --
  # see place_at_rect -- and a rect on a monitor that has since gone away falls back to
  # parking rather than failing the recording over a preference.
  if [[ $EXCLUDE == "yes" && -n $REQUEST_RECT ]] && place_at_rect; then
    :
  else
    find_park_spot || return 1
  fi
  if [[ $EXCLUDE == "yes" ]]; then
    apply_self_view_rule || return 1
    SELF_VIEW_TITLE="$EXCLUDED_SELF_VIEW_TITLE"
  fi

  rm -f "$FIFO"
  mkfifo "$FIFO" || return 1
  return 0
}

# mpv relays the FIFO through cat, and the whole pipeline is its own session so a single
# kill on the process group takes down both halves.
launch_preview() {
  # readahead/max-bytes are NOT in mpv's low-latency profile (check with
  # `mpv --show-profile=low-latency`), and default to 1s and 150MiB. For a stream that
  # arrives in real time, readahead is latency: mpv fills it before it starts drawing
  # and then consumes at the rate frames arrive, so the buffer never drains and the
  # preview sits permanently that far behind.
  #
  # UNVERIFIED as the cause of the reported 1-5s lag. What has been measured and ruled
  # out: the capture pipeline keeps up at 4K (constant 0.5s of startup at both 300 and
  # 600 frames, not a growing deficit); mpv keeps up as a consumer, alone and against a
  # competing 5K screen encode, with zero queue overflows; and fd://0 works on this
  # build. This is the remaining plausible mechanism and the change is one flag.
  setsid bash -c '
    echo $$ >"$3"
    cat "$1" | mpv --demuxer-lavf-format=mpjpeg \
      --profile=low-latency --untimed --no-cache --cache=no \
      --demuxer-readahead-secs=0 --demuxer-max-bytes=2MiB \
      --title="$4" --wayland-app-id="$4-$2" \
      --script-opts='"$SELF_VIEW_MARKER"' \
      --keepaspect=yes --panscan=1.0 --video-unscaled=no \
      --vf=hflip \
      --no-border --no-audio --no-osc --osd-level=0 --really-quiet fd://0
  ' _ "$FIFO" "$SIZE" "$PREVIEW_PID_FILE" "$SELF_VIEW_TITLE" &>/dev/null 9>&- &   # LOCK_FD_NOTE

  local waited=0
  while ((waited < 60)) && ! hyprctl clients -j | jq -e --arg t "$SELF_VIEW_TITLE" 'any(.[]; .title == $t)' >/dev/null 2>&1; do
    sleep 0.05
    ((waited++))
  done

  echo "$(date +%H:%M:%S.%3N) preview: mpv window mapped after ${waited} polls" >>"$LOG_FILE"

  local address
  address=$(hyprctl clients -j | jq -r --arg t "$SELF_VIEW_TITLE" 'first(.[] | select(.title == $t) | .address) // empty')
  [[ -n $address ]] || return 1

  # Inside the capture, the window is only acceptable if the compositor really did mark
  # it: a preview the portal can see is the user's face in the recording. The effective
  # rule is only reachable through `hyprctl getprop`; `hyprctl clients -j` carries no
  # noScreenShare field at all, so asking there answers "not marked" for every window
  # and silently disables the mode even when the rule did land.
  if [[ $EXCLUDE == "yes" ]] &&
    [[ $(hyprctl getprop "address:$address" no_screen_share 2>/dev/null) != "true" ]]; then
    echo "self-view off: Hyprland did not apply no_screen_share to the preview, so it would be recorded" >&2
    stop_preview
    return 1
  fi

  local window="address:$address"
  hypr_dispatch \
    "hl.dsp.window.resize({ window = \"$window\", x = $PRESET_W, y = $PRESET_H })" \
    resizewindowpixel "exact $PRESET_W $PRESET_H,$window"
  hypr_dispatch \
    "hl.dsp.window.move({ window = \"$window\", x = $PARK_X, y = $PARK_Y })" \
    movewindowpixel "exact $PARK_X $PARK_Y,$window"
  shape_self_view "$window"
}

start_camera() {
  local bundle=$1
  [[ -d $bundle/media ]] || {
    echo "not a recording bundle: $bundle" >&2
    return 1
  }

  stop_camera

  resolve_device || {
    echo "no webcam devices found" >&2
    return 1
  }
  resolve_capture_format || {
    echo "$DEVICE offers no usable NV12 or MJPEG mode. It reports:" >&2
    v4l2-ctl --list-formats-ext -d "$DEVICE" 2>/dev/null |
      grep -E "^[[:space:]]*\[[0-9]+\]|Size: Discrete" | sed 's/^/  /' >&2
    return 1
  }

  local preview_branch=()
  if [[ $SELF_VIEW == "yes" ]]; then
    if start_preview; then
      # Only wired up when something will read it: ffmpeg's fifo muxer blocks on opening
      # the FIFO for write until a reader appears, so an unread branch would hang the
      # output thread and stall the graceful shutdown at stop.
      #
      # SCALED ON THE GPU AND RE-ENCODED SMALL, not copied. Three measurements got this
      # to its current shape, all on a 3840x2160 camera:
      #
      #   * `-c:v copy` of the camera's native MJPEG (the original) was free for the
      #     recorder and ruinous for the preview: mpv had to decode 8.3 megapixels 30
      #     times a second, sat at 136% CPU, and fell 1-3 SECONDS behind -- reported as
      #     moving in the chair and watching it arrive a beat later.
      #   * Scaling it down on the CPU instead fixed mpv (12%) and moved the problem into
      #     this ffmpeg: 142.8% without a preview branch, 195.6% with one. Two cores is
      #     not a budget, it is a ceiling, and past it the frames simply do not arrive on
      #     time -- the same lag, one process to the left.
      #   * The frames are ALREADY on the GPU: the recording branch uploads them for
      #     h264_vaapi. So the graph splits after that upload and scales the preview copy
      #     with scale_vaapi, which costs the CPU nothing.
      #
      # Hence one filtergraph rather than a -vf per output: the decode, the nv12
      # conversion and the upload happen ONCE and both branches read the result. Doing it
      # with two -vf chains would run all of that twice, which is what made the CPU
      # version so expensive.
      #
      # Sized off the SHORT side, because mpv panscans this to fill a square window: at
      # 2x the window's logical size the square crop is still crisp on a HiDPI display.
      # queue_size 6, not 30: at 30fps that was a full second of buffered latency in
      # front of a preview whose only job is to be current, and dropping frames is the
      # right failure for it -- the recording is a separate branch and unaffected.
      preview_branch=(
        -map "[pv]" -c:v mjpeg -q:v 6
        -f fifo -fifo_format mpjpeg -queue_size 6 -drop_pkts_on_overflow 1
        -attempt_recovery 1 -recover_any_error 1 -max_recovery_attempts 100 -recovery_wait_time 1
        "$FIFO"
      )
    else
      # Not a failure: the camera still records to its own stream and stays fully
      # editable afterwards. Only the live preview is unavailable, because the capture
      # region leaves nowhere on screen to park a window that the capture would not
      # then swallow. Say what the user can do instead of only what did not happen.
      echo "self-view off: the capture region fills the screen, so there is nowhere to" >&2
      echo "  put a preview that would not be recorded. The camera is still being" >&2
      echo "  recorded separately and stays movable in the editor. For a live preview," >&2
      echo "  select a smaller region so there is room beside it." >&2
    fi
  fi

  # ONE graph, so the decode, the nv12 conversion and the upload to the GPU happen once
  # and every output reads the result. A -vf per output would repeat all three, which is
  # exactly what made the CPU-scaled preview cost 53% of a core on top of the 143% the 4K
  # encode already needed.
  # The conversion is only there for MJPEG: it decodes to yuvj422p, which the encoder
  # cannot take. An nv12 capture is already in the encoder's own format, so the whole
  # swscale pass -- the expensive half of the MJPEG path -- simply does not exist.
  local convert=""
  [[ $CAM_PIXFMT == "nv12" ]] || convert="format=nv12,"
  # The cap is applied once, before the split -- so the preview scales from the
  # already-reduced frame and the expensive branch gets smaller too.
  local cap="" filtergraph
  local hw_args=() encode_args=()
  if vaapi_encode_available; then
    ((CAM_HEIGHT > CAM_RECORD_MAX_H)) && cap=",scale_vaapi=w=-2:h=$(camera_encode_height)"
    filtergraph="[0:v]${convert}hwupload${cap}[enc]"
    if ((${#preview_branch[@]})); then
      filtergraph="[0:v]${convert}hwupload${cap},split=2[enc][pv_hw];"
      filtergraph+="[pv_hw]scale_vaapi=w=-2:h=$((PRESET_W * 2)),hwdownload,format=nv12[pv]"
    fi
    hw_args=(-vaapi_device /dev/dri/renderD128)
    encode_args=(-c:v h264_vaapi)
  else
    # No hardware encoder on this machine (see vaapi_encode_available). Same ONE graph --
    # one decode, one split, both branches still reading a single result -- with the GPU
    # upload and the two scale_vaapi filters swapped for their CPU equivalents. There is
    # no hwdownload on the preview branch because nothing ever went up.
    #
    # ultrafast, not superfast: superfast restores CABAC for about +58% CPU, and at this
    # bitrate that buys nothing visible in a master which is re-encoded at export anyway.
    # What it does cost is the headroom keeping the SCREEN encode above realtime, and a
    # dropped frame is a worse quality loss than no CABAC. Override with
    # OMARCHY_CAMERA_X264_PRESET if a machine has cores to spare.
    #
    # -threads 4 rather than unbounded: measured 110-129% of a core against 125-143%
    # here, at 1920x1440@30 with the preview branch live. Do NOT add sliced-threads,
    # which made it worse (160-182%).
    ((CAM_HEIGHT > CAM_RECORD_MAX_H)) && cap=",scale=w=-2:h=$(camera_encode_height)"
    filtergraph="[0:v]format=nv12${cap}[enc]"
    if ((${#preview_branch[@]})); then
      filtergraph="[0:v]format=nv12${cap},split=2[enc][pv_src];"
      filtergraph+="[pv_src]scale=w=-2:h=$((PRESET_W * 2))[pv]"
    fi
    encode_args=(-c:v libx264 -preset "${OMARCHY_CAMERA_X264_PRESET:-ultrafast}" -threads 4)
  fi

  : >"$LOG_FILE"
  # Timestamped, and with the preview's own launch marked, so a report of "the
  # self-view is seconds behind" has something to measure against instead of a
  # reconstruction after the fact.
  echo "$(date +%H:%M:%S.%3N) camera: ${CAM_WIDTH}x${CAM_HEIGHT}@${CAM_FPS} ${CAM_PIXFMT}${
    } -> encode at $(camera_encode_height)p $(camera_bitrate) via ${encode_args[1]}" >>"$LOG_FILE"

  # The device is routinely still held when a recording starts: the setup window's own
  # preview lets go a beat before this runs, and V4L2 hands the device on a beat after
  # that. ffmpeg does not wait for the handover -- it exits inside ~200ms with "Device
  # or resource busy" -- so the frame wait below never gets the chance to be patient
  # about it. Patience has to live here, in relaunching, not in waiting.
  local deadline=$((SECONDS + 12)) started="no" pid
  while :; do
    # `echo $$` before exec so the pid file holds ffmpeg's own pid whether or not setsid
    # forked, and SIGINT to that pid at stop writes a complete moov atom.
    # LOCK_FD_NOTE: 9>&- closes the inherited camera lock in the child. Without it this
    # ffmpeg holds the lock for the whole recording and every stop deadlocks against it.
    setsid bash -c 'echo $$ >"$1"; shift; exec "$@"' _ "$PID_FILE" \
      ffmpeg -hide_banner -loglevel warning -y \
      "${hw_args[@]}" \
      -copyts -f v4l2 -ts abs -input_format "$CAM_PIXFMT" \
      -video_size "${CAM_WIDTH}x${CAM_HEIGHT}" -framerate "$CAM_FPS" -i "$DEVICE" \
      -filter_complex "$filtergraph" \
      -map "[enc]" "${encode_args[@]}" -b:v "$(camera_bitrate)" "$bundle/media/cam.mp4" \
      -map 0:v -c:v copy -f mkvtimestamp_v2 "$bundle/media/cam.tsv" \
      "${preview_branch[@]}" \
      >>"$LOG_FILE" 2>&1 9>&- &

    await_camera_frames "$bundle" && {
      started="yes"
      break
    }

    # Only a device someone else was holding is worth another go. Every other failure
    # fails the same way twice, and the second one costs the user twelve more seconds
    # before they are told the same thing.
    grep -qi "resource busy" "$LOG_FILE" || break
    ((SECONDS < deadline)) || break

    # Not stop_camera: that also tears down the preview and removes the FIFO the next
    # attempt's preview branch is about to write to.
    for pid in $(fanout_pids); do
      kill -INT "$pid" 2>/dev/null
    done
    : >"$LOG_FILE"
    echo "camera: ${CAM_WIDTH}x${CAM_HEIGHT}@${CAM_FPS} ${CAM_PIXFMT} -> $(camera_bitrate) (device busy, retrying)" >>"$LOG_FILE"
    sleep 0.4
  done

  if [[ $started != "yes" ]]; then
    echo "camera did not start: $(tail -1 "$LOG_FILE" 2>/dev/null) (full log: $LOG_FILE)" >&2
    stop_camera
    return 1
  fi

  [[ ${#preview_branch[@]} -gt 0 ]] && launch_preview
  return 0
}

# A growing cam.mp4 is the only honest signal that the device is delivering. cam.tsv
# looks empty for the first ~77 seconds because the timestamp muxer writes through a 32KB
# AVIO buffer that only flushes when it fills or the file closes, so waiting on it here
# declared every short recording a failure; and the mp4 container header is written
# before any frame arrives, so a non-empty file is not enough either. Ten seconds, not
# the 661ms one measured run took to reach its first frame.
#
# Liveness is asked of fanout_pids, never of the pid file. That file is written by the
# setsid child, and this loop can reach its first check before the write lands -- an
# empty pid made `alive` answer "dead" and killed a camera that was starting perfectly
# well. It only lost the race under load, which is precisely when a recording starts.
# Absence only counts once the process has been seen, or after a second of never seeing
# it, so an ffmpeg that dies on the device handover is still noticed promptly.
await_camera_frames() {
  local bundle=$1 waited=0 size=0 previous=0 seen="no"
  while ((waited < 200)); do
    size=$(stat -c %s "$bundle/media/cam.mp4" 2>/dev/null || echo 0)
    ((previous > 0 && size > previous)) && return 0
    previous=$size
    if [[ -n $(fanout_pids) ]]; then
      seen="yes"
    elif [[ $seen == "yes" ]] || ((waited > 20)); then
      return 1
    fi
    sleep 0.05
    ((waited++))
  done
  return 1
}

# Every fan-out ffmpeg, whether or not it still has a pid file. Both halves of the match
# matter: the pattern is specific to this command's own timestamp branch, and the process
# name check means a shell whose arguments merely mention it is never a target.
fanout_pids() {
  local pid
  # The PID FILE first, verified. It was written and then never used to signal
  # anything, while the pattern below did all the work -- and the pattern's `[^ ]*`
  # cannot cross a SPACE, so a bundle under "~/My Videos" (which capture.py's own
  # comment says is routine) matched nothing: stop signalled no one, the ffmpeg kept
  # /dev/video0 open with the webcam light on, and cam.mp4 grew without end. That is
  # the exact symptom the recorder records as previously observed.
  pid=$(cat "$PID_FILE" 2>/dev/null)
  if [[ -n $pid && $(ps -o comm= -p "$pid" 2>/dev/null) == "ffmpeg" ]]; then
    echo "$pid"
    return 0
  fi
  # Fallback for a camera started before the pid file was trustworthy. `.*` not
  # `[^ ]*`, so a path with spaces still matches; -u so another account's process is
  # never a candidate; and the comm check still means a shell that merely mentions the
  # string is not one either.
  for pid in $(pgrep -u "$(id -u)" -f "mkvtimestamp_v2 .*/media/cam\.tsv" 2>/dev/null); do
    [[ $(ps -o comm= -p "$pid" 2>/dev/null) == "ffmpeg" ]] && echo "$pid"
  done
}

stop_preview() {
  local pid
  pid=$(cat "$PREVIEW_PID_FILE" 2>/dev/null)
  alive "$pid" && kill -- "-$pid" 2>/dev/null
  rm -f "$PREVIEW_PID_FILE"

  for pid in $(pgrep -u "$(id -u)" -f "$SELF_VIEW_MARKER" 2>/dev/null); do
    [[ $(ps -o comm= -p "$pid" 2>/dev/null) == "mpv" ]] && kill "$pid" 2>/dev/null
  done
  # -x -f: the whole command line must be exactly this, so no wrapper shell that merely
  # mentions the FIFO can be caught by it.
  pkill -u "$(id -u)" -x -f "cat $FIFO" 2>/dev/null
}

stop_camera() {
  # The preview goes first: a self-view outliving the recorder is a frozen frame of the
  # user's face on their desktop.
  stop_preview

  local pid waited=0
  for pid in $(fanout_pids); do
    # SIGINT, not SIGTERM: ffmpeg writes the trailer and flushes cam.tsv on the way out,
    # and a hard kill leaves an mp4 with no moov atom -- unreadable, verified.
    kill -INT "$pid" 2>/dev/null
  done
  while [[ -n $(fanout_pids) ]] && ((waited < 50)); do
    sleep 0.1
    ((waited++))
  done
  for pid in $(fanout_pids); do
    kill -9 "$pid" 2>/dev/null
  done

  rm -f "$PID_FILE" "$FIFO"
}

# Asked of the processes rather than the pid file, so a fan-out that survived a crashed
# start still reports as running -- it is holding the V4L2 device either way.
camera_active() {
  [[ -n $(fanout_pids) ]]
}

command -v ffmpeg >/dev/null || {
  echo "ffmpeg is required" >&2
  exit 1
}

# Held for the whole of start or stop, so the second caller waits and then finds
# nothing left to signal rather than hard-killing a trailer that was being written.
# `status` is a read and stays unlocked: it must answer while a stop is in flight.
# flock is util-linux and always present here, but a missing one must not be the thing
# that stops a recording -- without it the old race is simply back.
#
# TWO THINGS HERE ARE LOAD-BEARING, both learned the hard way in one sitting:
#
#   * every long-lived child MUST be spawned with 9>&- (see LOCK_FD_NOTE below). An fd
#     opened by `exec 9>` has no close-on-exec, so the camera ffmpeg inherited the fd
#     AND the lock on it, and held both for the entire recording. Every later stop then
#     blocked forever on a lock owned by the process it was trying to stop: the webcam
#     light stayed on and cam.mp4 grew to 196MB before it was noticed.
#   * the wait is BOUNDED. If an fd ever leaks again, a stop that degrades to the old
#     race is a bad day; a stop that hangs forever never releases /dev/video0, which is
#     strictly worse. Ten seconds is far longer than a real stop (a trailer flush is
#     well under a second) and far shorter than a person's patience.
with_camera_lock() {
  command -v flock >/dev/null || return 0
  exec 9>"$LOCK_FILE"
  flock -w 10 9 || echo "camera lock timed out; proceeding unserialized" >&2
}

ACTION=${1:-}
shift || true

case $ACTION in
start)
  BUNDLE=${1:-}
  [[ -n $BUNDLE ]] || usage
  shift
  for arg in "$@"; do
    case "$arg" in
    --device=*) DEVICE="${arg#*=}" ;;
    --size=*) SIZE="${arg#*=}" ;;
    --self-view=*) SELF_VIEW="${arg#*=}" ;;
    --outside=*) OUTSIDE="${arg#*=}" ;;
    --rect=*) REQUEST_RECT="${arg#*=}" ;;
    --shape=*) SHAPE="${arg#*=}" ;;
    --exclude=*) EXCLUDE="${arg#*=}" ;;
    --fps=*) FPS="${arg#*=}" ;;
    *) usage ;;
    esac
  done
  case $SIZE in
  small | medium | large) ;;
  *)
    echo "Invalid webcam size: $SIZE (expected small, medium, or large)" >&2
    exit 1
    ;;
  esac
  with_camera_lock
  start_camera "$BUNDLE"
  ;;
stop)
  with_camera_lock
  stop_camera
  ;;
status)
  camera_active
  ;;
*)
  usage
  ;;
esac
