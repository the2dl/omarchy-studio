#!/usr/bin/env python3
"""The pre-record entry point: a bottom-centre setup bar plus in-place pick overlays.

Record lives OFF the setup surface and on the picked target itself -- an overlay on
the chosen display/window/area shows its name, resolution and fps with the Start
button in the centre, which doubles as proof you picked the right monitor. This
launcher builds that on Hyprland: one frameless qml6
bar (mode / mic / camera / system audio) and one transparent full-monitor overlay
window per output, positioned with the same hl.dsp.window dispatches the self-view
uses (bin/omarchy-capture-camera).

Prints the chosen configuration to stdout as ONE line of JSON, or exits 1 when the
pick is cancelled. The schema lives in setup_sources.config; the consumer is
bin/omarchy-capture-screenrecording. Timing contract:

* countdown > 0 (default 3): the JSON line is printed the MOMENT Start is pressed,
  so the consumer can kick off capture initialisation while the countdown runs --
  counting down first and starting capture after would serialize the two waits.
  The line carries "countdown": N; every setup surface (bar, overlays, the count
  itself) is destroyed no later than N seconds after the line, so frames captured
  before N belong to the countdown and must not be kept.
* countdown == 0: the line is printed only after every window is destroyed plus a
  0.4s compositor settle, so capture may keep frames immediately.

Launch pattern notes shared with bin/omarchy-studio, each one a past debugging
session: /usr/bin/qml6 by absolute path (plain `qml` is Qt 5.15 and dies silently),
QT_ASSUME_STDERR_HAS_CONSOLE=1 (or QML warnings vanish into the journal), and a
tokened loopback bridge (any local process can reach a loopback port, and this one
can freeze the screen via the Area picker).

usage: omarchy-capture-setup [--countdown N] [--mode N] [--selftest MS] [--port N]
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO / "lib"))

from omarchy_studio import qmlbridge, setup_sources  # noqa: E402
from omarchy_studio.micmeter import MicMeter  # noqa: E402
from omarchy_studio.qmlbridge import theme_tokens  # noqa: E402

QML6 = "/usr/bin/qml6"
SETUP_QML = REPO / "editor" / "setup" / "main.qml"
REGION_PICKER = "omarchy-capture-region"
WEBCAM_LIST = "omarchy-capture-webcam-list"

# Window titles are the join key between QML and Hyprland: rules match them before
# the windows map, dispatches find their addresses after.
# Renamed from "omarchy-setup-overlay-": a dynamic window rule cannot be removed
# from a running Hyprland, and a no_focus rule matching the old prefix was installed
# during development. no_focus turned out to block POINTER input too, not just
# keyboard -- it made the sheet completely deaf, killing Start recording, the window
# picker and the device lists. Any session that ever ran that build still carries the
# rule, so the way out is a title it does not match.
OVERLAY_PREFIX = "omarchy-setup-sheet-"
# The teleprompter's window title, as bin/omarchy-teleprompter sets it. The sheet has to
# find that window to draw a drag proxy over it.
PROMPTER_TITLE = "omarchy-studio-teleprompter"

# Every window of ours, by title prefix, kept out of the Window tab. The first
# enumeration runs before qml6 spawns and needs none of this; the re-enumerations
# added for hot-plug (below) run with the sheets and possibly the prompter mapped,
# and a card offering "capture the sheet that is covering your screen" is not a
# choice a user can want.
OUR_WINDOW_PREFIXES = (OVERLAY_PREFIX, PROMPTER_TITLE)

# How often the source lists are rebuilt while the bar is up. Devices are the reason:
# plugging a camera or a USB/Bluetooth mic in AFTER the bar opened used to leave the
# chip reading "no camera" for the life of the process, with the shape control disabled
# beside it -- the device existed, the UI just never asked again. Two seconds is under
# the "did it not see it?" threshold and costs four short subprocesses when it fires.
RESCAN_SECONDS = 2.0


def _run_json(cmd: list[str]) -> list:
    try:
        return json.loads(subprocess.run(cmd, capture_output=True, text=True,
                                         timeout=5, check=True).stdout)
    except Exception:
        return []


def _run_text(cmd: list[str]) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True,
                              timeout=5, check=True).stdout
    except Exception:
        return ""


def video_nodes() -> tuple[str, ...]:
    """The /dev/videoN nodes that exist right now, sorted.

    A free change-detector for the rescan. `omarchy-capture-webcam-list` costs ~86ms
    -- it runs `v4l2-ctl --info` once per device -- which is most of an enumeration,
    and re-paying it every two seconds to learn nothing is the kind of idle burn a
    pre-record surface should not have. Any camera arriving or leaving moves this set,
    and nothing else does, so it is an exact gate rather than a heuristic.
    """
    try:
        return tuple(sorted(str(p) for p in Path("/dev").glob("video*")))
    except OSError:
        return ()


def list_mics() -> list[dict]:
    """Every real capture source, default first, for the bar's mic picker.

    Default first because that is the one the bar opens on and the one most runs
    keep; the rest follow in pactl order. An empty list means no mic at all, which
    the bar shows as "no mic" rather than an empty picker."""
    default = _run_text(["pactl", "get-default-source"]).strip()
    found = setup_sources.mics(
        _run_json(["pactl", "--format=json", "list", "sources"]), default)
    found.sort(key=lambda m: not m["default"])
    return found


# --- Hyprland plumbing --------------------------------------------------------


def hypr_dispatch(lua: str, legacy: list[str]) -> None:
    """Lua form first, legacy string second -- the string forms are dead under
    Omarchy's Lua parser on current builds, and the Lua form is missing on older
    ones. Same dance as bin/omarchy-capture-camera's hypr_dispatch."""
    r = subprocess.run(["hyprctl", "dispatch", lua], capture_output=True, text=True)
    if r.returncode != 0 or "error" in (r.stdout + r.stderr).lower():
        subprocess.run(["hyprctl", "dispatch"] + legacy, capture_output=True)


def install_window_rules() -> None:
    """Dynamic rules for the bar and overlays, installed BEFORE qml6 spawns so
    they apply at map time.

    Field names were probed against the live parser (unknown fields are refused
    by name): float/pin/no_shadow/no_dim/border_size/rounding/animation/
    no_initial_focus/opacity. animation="none" matters twice over -- windows must
    appear in place rather than glide in, and at Record time the unmap must not
    leave a fading snapshot on screen for the capture to swallow. Dynamic rules
    cannot be removed from here; they match only these titles and re-adding them
    on the next run is idempotent in effect.
    """
    common = ('float = true, pin = true, no_dim = true, border_size = 0, '
              'animation = "none", opacity = "1 1"')
    rules = [
        # One rule, because there is now one kind of window. The bar used to be a
        # second, frameless window beside these sheets, and the two could not be kept
        # in a workable stacking order: the sheet maps second and covered it, raising
        # the bar did not survive focus-follows-mouse, and no_focus on the sheet only
        # traded a dead bar for a deaf sheet. The bar is an item inside the sheet now
        # (editor/setup/SetupBar.qml), so none of that arises.
        f'hl.window_rule({{ match = {{ title = "^{OVERLAY_PREFIX}.*$" }}, {common}, '
        f'rounding = 0, no_shadow = true }})',
    ]
    for rule in rules:
        subprocess.run(["hyprctl", "eval", rule], capture_output=True)


def position_windows(mons: list[dict], focused_name: str) -> None:
    """Move each mapped window to its place: overlays onto their monitors, the bar
    bottom-centre on the focused one. Position comes from a dispatch rather than a
    rule because it is per-window arithmetic on enumerated monitors, not an
    expression on whichever monitor the window happens to spawn on."""
    by_name = {m["name"]: m for m in mons}
    # The clock starts before qml6 has even launched, and the overlays only exist
    # once the async /sources fetch lands. Three seconds covered a warm start and
    # nothing else: overrunning it leaves the bar wherever Hyprland first put it --
    # mid-screen, unpositioned, and never raised, so every control under the overlay
    # is dead. Observed on a cold start while auditing. Ten seconds is still a bound
    # (the loop exits the moment everything is placed), just not one a normal launch
    # can trip over.
    deadline = time.monotonic() + 10.0
    placed: set[str] = set()
    want = {OVERLAY_PREFIX + m["name"] for m in mons}
    while time.monotonic() < deadline and placed != want:
        for c in _run_json(["hyprctl", "clients", "-j"]):
            title = c.get("title", "")
            if title not in want or title in placed:
                continue
            addr = c.get("address", "")
            if not addr:
                continue
            mon = by_name.get(title[len(OVERLAY_PREFIX):])
            if mon is None:
                continue
            x, y = mon["x"], mon["y"]
            hypr_dispatch(
                f'hl.dsp.window.move({{ window = "address:{addr}", x = {x}, y = {y} }})',
                ["movewindowpixel", f"exact {x} {y},address:{addr}"])
            placed.add(title)
        if placed != want:
            time.sleep(0.05)

    # The overlays are monitor-sized sheets with a full-fill MouseArea, and they map
    # after the bar (they are instantiated from /sources, which arrives async), so
    # Hyprland stacks them on top of it. The bar stays visible through the transparent
    # sheet but every click over it lands on the overlay instead -- proven by clicks
    # inside the bar's rect arriving at the overlay's handler. Raising the bar last,
    # once everything has mapped, is what makes its controls clickable at all. The
    # picker remaps the surfaces, so this runs again on every reposition.

# --- mic level ----------------------------------------------------------------


# --- the bridge ---------------------------------------------------------------


class SetupSession:
    def __init__(self, tmp: Path | None = None, countdown: int = 3) -> None:
        self.tmp = tmp
        self.countdown = countdown
        self.token = os.urandom(16).hex()
        self.meter = MicMeter()
        self.sources: dict = {"monitors": [], "windows": [], "cameras": [],
                              "mics": [], "mic": None}
        self.result: dict | None = None
        self.done = threading.Event()
        self.lock = threading.Lock()
        self.reposition: object | None = None   # set by main() once windows exist
        self.prompter: subprocess.Popen | None = None
        # True while pick_area holds the screen; pauses the hot-plug rescan.
        self.picking = False
        # The monitor set as of the last enumeration; None until the first one, so
        # that baseline pass does not read as a display having been plugged in.
        self._monitor_names: list[str] | None = None
        # The camera scan and the node set it was taken from; see video_nodes().
        self._cameras: list[dict] | None = None
        self._camera_nodes: tuple[str, ...] = ()
        # Set once the user picks a mic by hand, after which the rescan stops
        # retargeting the meter for them.
        self.mic_pinned = False

    def prompter_rect(self) -> dict:
        """Where the teleprompter is, in logical desktop pixels.

        The sheet needs this because it cannot be dragged directly while the sheet is up:
        the sheet is monitor-sized and takes the pointer, and raising the prompter above
        it does not hold -- with focus-follows-mouse the pointer must CROSS the sheet to
        reach the prompter, which focuses and re-raises the sheet, dropping the prompter
        back under. Verified with bring_to_top: the sheet stayed focused through it. So
        the sheet draws a proxy over the prompter and moves the real window instead,
        which is the same thing it already does for the camera self-view.
        """
        try:
            clients = json.loads(_run_text(["hyprctl", "clients", "-j"]) or "[]")
        except json.JSONDecodeError:
            return {"running": False}
        for c in clients:
            if c.get("title") == PROMPTER_TITLE:
                at, size = c.get("at") or [0, 0], c.get("size") or [0, 0]
                return {"running": True, "address": c.get("address", ""),
                        "x": at[0], "y": at[1], "width": size[0], "height": size[1]}
        return {"running": False}

    def move_prompter(self, x: int, y: int) -> dict:
        rect = self.prompter_rect()
        if not rect.get("running"):
            return rect
        hypr_dispatch(
            f"hl.dsp.window.move({{ x = {int(x)}, y = {int(y)}, "
            f"window = 'address:{rect['address']}' }})",
            ["movewindowpixel", f"exact {int(x)} {int(y)},address:{rect['address']}"])
        rect["x"], rect["y"] = int(x), int(y)
        return rect

    def set_prompter(self, on: bool) -> bool:
        """Raise or drop the teleprompter, and answer with what actually happened.

        Its own process, not a window of this one: these surfaces are destroyed the
        moment Record is pressed and the script has to still be on screen after that,
        and start_new_session keeps it alive when this launcher's process group goes.
        Left to warn for itself about a compositor that cannot hide it from the capture
        -- that warning is the one thing about the prompter worth interrupting for.
        """
        if on and (self.prompter is None or self.prompter.poll() is not None):
            try:
                self.prompter = subprocess.Popen(
                    [str(REPO / "bin" / "omarchy-teleprompter"), "--owned-by-recording"],
                    start_new_session=True,
                    # STDOUT MUST NOT BE INHERITED. This process's stdout is the contract
                    # pipe -- bin/omarchy-capture-screenrecording reads the setup JSON
                    # with `setup_json=$(omarchy-capture-setup)`, and a command
                    # substitution ends at EOF, which needs EVERY writer to close. The
                    # prompter is meant to outlive this process, so an inherited stdout
                    # holds that pipe open forever: the picker exits, the JSON is printed
                    # and the recorder still blocks in anon_pipe_read, having never
                    # started. Observed exactly that way -- the recorder's fd 3 and the
                    # prompter's fd 1 on the same pipe inode.
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL)
            except OSError:
                self.prompter = None
        elif not on and self.prompter is not None:
            self.prompter.terminate()
            self.prompter = None
        return self.prompter is not None and self.prompter.poll() is None

    def enumerate(self) -> None:
        """Rebuild every source list from the live system.

        Called once before qml6 spawns and then every RESCAN_SECONDS, so a device
        that appears while the bar is open reaches the UI. Writes under the lock
        because /sources is served from a different thread.
        """
        mics = list_mics()
        mons_raw = _run_json(["hyprctl", "monitors", "-j"])
        clients = _run_json(["hyprctl", "clients", "-j"])
        ws = setup_sources.active_workspace(mons_raw)
        focused = next((m["name"] for m in mons_raw if m.get("focused")), "")
        nodes = video_nodes()
        if nodes != self._camera_nodes or self._cameras is None:
            self._camera_nodes = nodes
            self._cameras = setup_sources.cameras(_run_text([WEBCAM_LIST]))
        fresh = {
            "monitors": setup_sources.monitors(mons_raw),
            "windows": setup_sources.windows(clients, ws, OUR_WINDOW_PREFIXES),
            "cameras": list(self._cameras),
            "mics": mics,
            # Kept alongside `mics` so nothing downstream has to special-case an
            # empty list to answer "is there a mic at all".
            "mic": mics[0] if mics else None,
            "focused": focused,
        }
        names = [m["name"] for m in fresh["monitors"]]
        with self.lock:
            self.focused = focused
            self.sources = fresh
        # A display that appears gets a sheet -- the Repeater is bound to this list --
        # but a sheet nobody moves maps wherever Hyprland decides, which on a second
        # output means that monitor's picker cards are drawn over the wrong screen.
        # position_windows polls for the titles it wants, so firing it now is fine even
        # though the new sheet is still a /sources fetch away from existing. `is not
        # None` and not a truth test: the FIRST enumeration establishes the baseline
        # (main() places the sheets itself right after), it does not report a change.
        changed = self._monitor_names is not None and names != self._monitor_names
        self._monitor_names = names
        if changed and self.reposition is not None:
            threading.Thread(target=self.reposition, daemon=True).start()
        # A mic that appears late is not just a list entry: the meter was started at
        # launch and, with no mic to open, parec exited and left it dead. Restart it on
        # the new default -- but only while the user has not picked a device, because
        # then the meter is answering a question they asked about a specific mic.
        if not self.mic_pinned:
            self.meter.retarget(mics[0]["name"] if mics else "")

    def rescan_forever(self) -> None:
        """The hot-plug poll. Skipped while the Area picker owns the screen: it has
        frozen a copy of the desktop with our windows unmapped, and enumerating into
        that would spend four subprocesses describing a world that is on hold."""
        while not self.done.wait(RESCAN_SECONDS):
            if self.picking:
                continue
            try:
                self.enumerate()
            except Exception:
                pass    # a transient hyprctl/pactl failure must not end the poll

    def pick_area(self) -> dict:
        """Run the existing slurp picker; the QML side has already hidden every
        window. The 0.3s pause lets the compositor actually unmap them --
        hyprpicker freezes whatever is on screen the instant it starts, and a
        lingering bar burned into the frozen frame was the reason to close first.
        """
        self.picking = True
        try:
            time.sleep(0.3)
            try:
                r = subprocess.run([REGION_PICKER, "smart", "--match-monitor"],
                                   capture_output=True, text=True, timeout=300)
            except (OSError, subprocess.TimeoutExpired):
                return {"cancelled": True}
        finally:
            self.picking = False
        if r.returncode != 0 or not r.stdout.strip():
            return {"cancelled": True}
        try:
            target = setup_sources.region_target(r.stdout.strip())
        except ValueError:
            return {"cancelled": True}
        reply: dict = {"target": target}
        parsed = setup_sources.parse_target(target)
        if parsed["kind"] == "region":
            # x/y ride along so the overlay can ring the picked rectangle in place.
            reply.update(x=parsed["x"], y=parsed["y"],
                         width=parsed["width"], height=parsed["height"])
        return reply


def serve(session: SetupSession, port: int) -> ThreadingHTTPServer:
    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *a):  # stdout is the contract; stderr stays quiet too
            pass

        def _send(self, obj, status=200):
            body = json.dumps(obj).encode()
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def _authed(self) -> bool:
            if self.headers.get("X-Studio-Token") == session.token:
                return True
            self._send({"error": "bad token"}, 403)
            return False

        def do_GET(self):
            if not self._authed():
                return
            if self.path == "/theme":
                return self._send(theme_tokens())
            if self.path == "/sources":
                with session.lock:
                    return self._send(session.sources)
            if self.path == "/prompter":
                return self._send(session.prompter_rect())
            if self.path == "/mic":
                return self._send({"level": session.meter.level,
                                   "db": session.meter.db,
                                   "alive": session.meter.alive})
            self._send({"error": "not found"}, 404)

        def do_POST(self):
            if not self._authed():
                return
            n = int(self.headers.get("Content-Length") or 0)
            try:
                body = json.loads(self.rfile.read(n) or b"{}")
            except json.JSONDecodeError:
                return self._send({"error": "bad json"}, 400)
            if self.path == "/area":
                reply = session.pick_area()
                # Unmapping for the picker destroyed the Wayland surfaces; the
                # windows that reappear are NEW clients at Hyprland's default
                # placement, so they must be repositioned exactly like at launch.
                if session.reposition is not None:
                    threading.Thread(target=session.reposition, daemon=True).start()
                return self._send(reply)
            if self.path == "/prompter":
                if "move" in body:
                    m = body["move"] or {}
                    return self._send(session.move_prompter(m.get("x", 0), m.get("y", 0)))
                return self._send({"on": session.set_prompter(bool(body.get("on")))})
            if self.path == "/mic-device":
                # The picker retargets the meter so the level answers for the device
                # about to be recorded, not the one that happened to be default.
                device = str(body.get("device") or "")
                session.mic_pinned = True
                session.meter.retarget(device)
                return self._send({"ok": True, "device": device})
            if self.path == "/done":
                try:
                    session.result = setup_sources.config(
                        target=body.get("target", ""),
                        mic=body.get("mic", False),
                        desktop_audio=body.get("desktop_audio", False),
                        camera=body.get("camera", "off"),
                        camera_device=body.get("camera_device"),
                        mic_device=body.get("mic_device"),
                        camera_rect=body.get("camera_rect"),
                        window=body.get("window"),
                        full_monitor=body.get("full_monitor", False),
                        window_isolated=body.get("window_isolated", False),
                        countdown=session.countdown,
                    )
                except ValueError as e:
                    return self._send({"error": str(e)}, 400)
                self._send({"ok": True})
                session.done.set()
                return
            if self.path == "/cancel":
                self._send({"ok": True})
                session.done.set()
                return
            self._send({"error": "not found"}, 404)

    srv = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    return srv


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="omarchy-capture-setup", description=__doc__)
    ap.add_argument("--countdown", type=int, default=3, metavar="N",
                    help="seconds of on-screen countdown after Start (0 = none); "
                         "the JSON line carries it so capture init can overlap")
    ap.add_argument("--selftest", type=int, default=0, metavar="MS",
                    help="open the windows, then exit (cancelled) after MS ms")
    ap.add_argument("--selftest-record", type=int, default=0, metavar="MS",
                    help="open the windows, press Start after MS ms, and run the "
                         "real countdown/teardown/print path -- the whole handoff, "
                         "minus the human")
    ap.add_argument("--port", type=int, default=0)
    ap.add_argument("--mode", type=int, default=0,
                    help="open on this mode (0-2); a verification hook, not UX")
    ap.add_argument("--open-picker", default="", choices=["", "mic", "camera"],
                    help="open a device list at startup; a verification hook, not UX")
    ap.add_argument("--camera-shape", default="",
                    choices=["", "circle", "rounded", "rect"],
                    help="open with the self-view showing; a verification hook, not UX")
    ap.add_argument("--probe-input", action="store_true",
                    help="report every control's screen rect and every pointer "
                         "position each window receives, for tests/input_audit.py")
    a = ap.parse_args(argv)

    if not Path(QML6).exists():
        print(f"{QML6} is missing; install qt6-declarative", file=sys.stderr)
        return 2

    session = SetupSession(countdown=max(0, a.countdown))
    session.enumerate()
    if not session.sources["monitors"]:
        print("no monitors reported by hyprctl; is Hyprland running?", file=sys.stderr)
        return 2
    # The meter is started by enumerate(), which is also what re-points it when a mic
    # appears later -- two starters would race over MicMeter's generation counter.
    threading.Thread(target=session.rescan_forever, daemon=True).start()
    server = serve(session, a.port)
    install_window_rules()

    env = dict(os.environ)
    env["QT_ASSUME_STDERR_HAS_CONSOLE"] = "1"
    env["QML_XHR_ALLOW_FILE_READ"] = "1"
    # The token's PATH, never its value: /proc/<pid>/cmdline is world-readable.
    token_file = qmlbridge.write_token_file(session.token)
    argvq = [QML6, "-I", str(REPO / "editor"), str(SETUP_QML), "--",
             "--port", str(server.server_port), "--token-file", str(token_file),
             "--countdown", str(session.countdown)]
    if a.selftest:
        argvq += ["--selftest", str(a.selftest)]
    if a.selftest_record:
        argvq += ["--selftest-record", str(a.selftest_record)]
    if a.mode:
        argvq += ["--mode", str(a.mode)]
    if a.probe_input:
        argvq += ["--probe-input", "1"]
    if a.open_picker:
        argvq += ["--open-picker", a.open_picker]
    if a.camera_shape:
        argvq += ["--camera-shape", a.camera_shape]
    proc = subprocess.Popen(argvq, env=env)

    session.reposition = lambda: position_windows(session.sources["monitors"],
                                                  session.focused)
    threading.Thread(target=session.reposition, daemon=True).start()

    # With a countdown, the contract prints the moment Start lands so the consumer
    # can absorb capture startup inside the countdown window (see module docstring).
    printed = threading.Event()

    def print_on_done() -> None:
        session.done.wait()
        if session.result is not None and session.countdown > 0:
            print(json.dumps(session.result), flush=True)
            printed.set()
    threading.Thread(target=print_on_done, daemon=True).start()

    try:
        # A wedged selftest must not hold a screenful of pinned overlays hostage
        # on a machine nobody is watching; interactively the user owns the wait.
        st = a.selftest or a.selftest_record
        proc.wait(timeout=(st / 1000.0 + 30) if st else None)
    except subprocess.TimeoutExpired:
        print("selftest: the setup windows did not exit; killing them", file=sys.stderr)
        proc.kill()
        proc.wait()
    except KeyboardInterrupt:
        proc.terminate()
        proc.wait()
    # This launch's token file; its child has read it long since.
    token_file.unlink(missing_ok=True)
    session.meter.stop()
    session.done.set()   # unblock print_on_done if the window died without posting
    server.shutdown()

    if session.result is not None:
        if session.countdown > 0:
            printed.wait(timeout=2)   # the print thread owns the line; just join it
        else:
            # countdown == 0: every window is already destroyed (the process just
            # exited) -- this settle covers the compositor finishing its last
            # frame before the consumer starts keeping everything it captures.
            time.sleep(0.4)
            print(json.dumps(session.result), flush=True)
        # Record was pressed: the RECORDING owns the prompter now, and the recorder's
        # stop path closes it. Leaving it up is the whole point -- it has to outlive
        # these surfaces to be readable during the take.
        return 0

    # Cancelled. Nothing owns the prompter, so whoever raised it has to put it back:
    # a Script toggle that leaves a window on screen after you escape the picker is a
    # window you then have to go and hunt for, and on a KMS capture it is a window that
    # will be in the NEXT take.
    session.set_prompter(False)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
