#!/bin/bash

# omarchy:summary=Start or stop screen recording
# omarchy:group=capture
# omarchy:args=[--fullscreen] [--with-desktop-audio] [--with-microphone-audio] [--with-webcam] [--burn-in] [--webcam-device=<device>] [--webcam-size=<small|medium|large>] [--resolution=<size>] [--framerate=<fps>] [--stop-recording]
# omarchy:examples=omarchy screenrecord | omarchy capture screenrecording --with-webcam
# omarchy:aliases=omarchy screenrecord
#
# A recording is a bundle directory, not a file: the screen, the camera and the input
# events are captured as separate streams beside an immutable capture.json, so the
# webcam can be moved, the zoom retimed and sections cut long after the fact. See
# lib/omarchy_studio/project.py for the layout.
#
# Nothing here re-encodes or trims the master. The old finalize step (-ss 0.1 plus
# loudnorm, then mv over the original) is gone -- overwriting the capture is exactly
# what a non-destructive pipeline cannot do, and the -100ms shift it applied silently
# invalidated the first-frame anchor everything else is timed against. Loudness
# normalization now happens at export, where it can be turned off again.
#
# Env: OMARCHY_SCREENRECORD_DEBUG=true appends gpu-screen-recorder's stderr to
# /tmp/omarchy-screenrecord.log.
#
# Backends. KMS (-w <monitor>) is the default: it reads the scanout below the
# compositor, so it is cheap and a clean 60fps -- and it sees everything, a self-view
# included. The portal (-w portal) is used for exactly one thing: a self-view that has to
# sit INSIDE the captured monitor. Hyprland's no_screen_share rule keeps that window out
# of portal frames (absent, not a black box, with the omarchy-studio-screenshare plugin),
# and nothing keeps it out of KMS frames. The portal never says which rectangle of which
# monitor it handed over, so its geometry is recovered from gsr's own
# "pipewire:    Size: WxH" line (-v yes) and accepted only when it matches exactly one
# monitor, which has to be the one we asked for -- capture.json cannot be written on a
# guess. Cost, measured on DP-1 at 5120x2880: the portal delivers ~55fps and the CFR
# master repeats 15-50% of its frames depending on GPU load, where KMS repeats none.
#
# Env: OMARCHY_SCREENRECORD_SELF_VIEW_EXCLUDE=no keeps the old behaviour (no self-view
# rather than the portal).

set -uo pipefail
# The stop path prints the finished file's path on stdout, and it also takes down the
# recording HUD -- which, when the HUD is what asked for the stop, is the process reading
# that stdout. Losing the reader must not lose the rest of the stop: without this, `echo
# "$master"` took SIGPIPE and the script died before opening the editor, so a take that
# recorded and finalized perfectly just never appeared. Defence in depth; the HUD also
# no longer holds a pipe on us.
trap "" PIPE

STUDIO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PATH="$STUDIO_ROOT/bin:$PATH"

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${OMARCHY_SCREENRECORD_DIR:-${XDG_VIDEOS_DIR:-$HOME/Videos}}"

if [[ ! -d $OUTPUT_DIR ]]; then
  omarchy-notification-send -u critical -t 3000 "Screen recording directory does not exist: $OUTPUT_DIR"
  exit 1
fi

DESKTOP_AUDIO="false"
MICROPHONE_AUDIO="false"
MICROPHONE_DEVICE=""
WEBCAM="false"
BURN_IN="false"
WEBCAM_DEVICE=""
WEBCAM_SIZE="medium"
# The self-view's shape, in the one vocabulary the bar, the model, the editor and the
# live preview all share. The setup bar overrides it; the flag-driven path has no shape
# control and takes the model's own default.
WEBCAM_SHAPE="circle"
RESOLUTION=""
# 60 everywhere the KMS backend is used, which is everything except an excluded
# self-view. --framerate=N pins it and stops the portal path from stepping down.
FRAMERATE=60
FRAMERATE_EXPLICIT=""
FULLSCREEN="false"
STOP_RECORDING="false"
# The setup bar is the default way in. --no-setup drops straight to the legacy slurp
# picker, which is what --fullscreen and scripted callers want.
SETUP="true"
SETUP_COUNTDOWN=""
COUNTDOWN_SECONDS=0
COUNTDOWN_UNTIL_US=0
# True when a person asked for the stop, as opposed to the recorder ending some other
# way. Only a deliberate stop opens the editor unprompted.
STOPPED_DELIBERATELY="false"
SCRIPT_ARGS="$*"

# A private runtime directory, never bare /tmp.
#
# `${XDG_RUNTIME_DIR:-/tmp}` put every state file this program owns -- including the
# supervisor's process set, whose (pid, start time) pairs are TRUSTED and signalled --
# into a world-writable directory whenever the variable was unset. XDG_RUNTIME_DIR is
# 0700 and per-user; the fallback is made to match rather than to be convenient. It is
# created 0700 and refused if it already exists owned by anyone else.
omarchy_runtime_dir() {
  if [[ -n ${XDG_RUNTIME_DIR:-} && -d $XDG_RUNTIME_DIR ]]; then
    printf '%s' "$XDG_RUNTIME_DIR"
    return 0
  fi
  local fallback="/tmp/omarchy-studio-$(id -u)"
  mkdir -p -m 700 "$fallback" 2>/dev/null
  if [[ -d $fallback && -O $fallback ]]; then
    chmod 700 "$fallback" 2>/dev/null
    printf '%s' "$fallback"
    return 0
  fi
  # Someone else owns it: fall back to a fresh private directory rather than sharing.
  mktemp -d "/tmp/omarchy-studio-XXXXXX"
}

RUNTIME_DIR="$(omarchy_runtime_dir)"
# In the per-user runtime dir, not /tmp. This was the one state file left in a
# world-writable directory while everything beside it used XDG_RUNTIME_DIR. Another
# account could pre-create the path -- it does not exist between recordings, so the
# window is every idle moment -- and the recorder would then write the master's path
# through their file, or through a symlink to somewhere else. fs.protected_symlinks and
# fs.protected_regular are on here and block the worst of it, but those are the
# machine's settings and not this program's to rely on; what is left even with them is
# another user permanently denying the path.
RECORDING_FILE="$RUNTIME_DIR/omarchy-screenrecord-filename"
BUNDLE_FILE="$RUNTIME_DIR/omarchy-studio-bundle"
# Which processes belong to THIS recording. The stop path is a second invocation of
# this script and has none of the variables that knew their pids, so it used to hunt
# for them by pattern -- `pkill -f "^gpu-screen-recorder"` -- which reaches a second
# recording by the same user and anything else whose argv merely contains the string.
# See lib/omarchy_studio/supervisor.py.
PROCS_FILE="$RUNTIME_DIR/omarchy-studio-procs.json"
# The stop is a SECOND invocation of this script -- the hotkey just runs it again --
# so nothing start_screenrecording put in a shell variable is visible to it. That is
# why the countdown deadline is written to a file: COUNTDOWN_SECONDS was read at stop
# time from a variable that is always still 0 there, so --trim-head-seconds was in
# practice never passed and every setup-bar recording kept its countdown frames.
COUNTDOWN_FILE="$RUNTIME_DIR/omarchy-studio-countdown-until-us"
IPC_SOCKET="$RUNTIME_DIR/omarchy-studio-gsr.sock"
REGION_FILE="$RUNTIME_DIR/omarchy-screenrecord-region"
LOG_FILE=$([[ ${OMARCHY_SCREENRECORD_DEBUG:-false} == "true" ]] && echo "$RUNTIME_DIR/omarchy-screenrecord.log" || echo "/dev/null")
# A one-line-per-event breadcrumb trail, always on, separate from the verbose debug log.
# It exists because "I pressed Record and nothing happened" was unanswerable: the
# verbose log is opt-in and defaults to /dev/null, so a failed recording left no trace
# anywhere -- no bundle, no log, no notification. This costs a few bytes per run and is
# the difference between diagnosing that and guessing at it.
TRAIL_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-studio/recorder.log"
trail() {
  mkdir -p "$(dirname "$TRAIL_FILE")" 2>/dev/null
  printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$TRAIL_FILE" 2>/dev/null
  # Keep it small enough to never need managing; 400 lines is months of recordings.
  if [[ $(wc -l <"$TRAIL_FILE" 2>/dev/null || echo 0) -gt 400 ]]; then
    tail -200 "$TRAIL_FILE" >"$TRAIL_FILE.tmp" 2>/dev/null && mv "$TRAIL_FILE.tmp" "$TRAIL_FILE"
  fi
}
# gsr's stderr, always kept for the current recording: the portal backend's geometry is
# read out of it, so it cannot go to /dev/null the way the debug log can.
GSR_STDERR="$RUNTIME_DIR/omarchy-studio-gsr.err"
# Where gsr keeps the portal's restore token. The share picker appears once per monitor;
# afterwards the token (persisted by xdg-desktop-portal, survives reboots while an output
# of that name exists) skips it.
PORTAL_TOKEN_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/gpu-screen-recorder/restore_token"
# The single-window recorder. Built from contrib/, not packaged, so its absence is a
# fallback rather than an error -- see the isolated branch below.
WINDOW_RECORDER="$STUDIO_ROOT/contrib/omarchy-capture-window/omarchy-capture-window"
HUD_PID_FILE="$RUNTIME_DIR/omarchy-studio-hud.pid"
# Only set when the setup bar's Script toggle raised the prompter, so a prompter the
# user started themselves is never taken away from them.
PROMPTER_OWNED_FILE="$RUNTIME_DIR/omarchy-studio-teleprompter.owned-by-recording"

# The one place cursor capture is decided. gsr burns the cursor into the frame and
# magnifies it softly under zoom; the fix is a synthetic cursor rendered from the event
# track at export, and until that exists a cursorless recording is the worse regression.
# Flip to "no" here, and only here, when it lands.
CURSOR_CAPTURE="yes"

STUDIO_PYTHON="${OMARCHY_STUDIO_PYTHON:-$STUDIO_ROOT/.venv/bin/python}"
[[ -x $STUDIO_PYTHON ]] || STUDIO_PYTHON="python3"

studio_capture() {
  PYTHONPATH="$STUDIO_ROOT/lib${PYTHONPATH:+:$PYTHONPATH}" "$STUDIO_PYTHON" -m omarchy_studio.capture "$@"
}

# CLOCK_MONOTONIC microseconds -- the same clock gsr stamps its first frame with, which
# is what makes the two comparable at finalize. Not /proc/uptime: that is BOOTTIME and
# includes suspend, so the two would disagree by however long the machine slept.
monotonic_us() {
  "$STUDIO_PYTHON" -c 'import time; print(time.clock_gettime_ns(time.CLOCK_MONOTONIC) // 1000)'
}

for arg in "$@"; do
  case "$arg" in
  --with-desktop-audio) DESKTOP_AUDIO="true" ;;
  --with-microphone-audio) MICROPHONE_AUDIO="true" ;;
  --with-webcam) WEBCAM="true" ;;
  --burn-in) BURN_IN="true" ;;
  --webcam-device=*) WEBCAM_DEVICE="${arg#*=}" ;;
  --webcam-size=*) WEBCAM_SIZE="${arg#*=}" ;;
  --resolution=*) RESOLUTION="${arg#*=}" ;;
  --framerate=*)
    FRAMERATE="${arg#*=}"
    FRAMERATE_EXPLICIT="yes"
    ;;
  --fullscreen) FULLSCREEN="true" ;;
  --no-setup) SETUP="false" ;;
  --countdown=*) SETUP_COUNTDOWN="${arg#*=}" ;;
  --stop-recording) STOP_RECORDING="true" ;;
  esac
done

case $WEBCAM_SIZE in
small | medium | large) ;;
*)
  echo "Invalid webcam size: $WEBCAM_SIZE (expected small, medium, or large)" >&2
  exit 1
  ;;
esac

# --- the burned-in camera path (unchanged behaviour) -------------------------
#
# An mpv overlay inside the captured region, recorded as pixels. Nothing in the editor
# can move or remove it afterwards, which is why it is not the default -- but it is what
# people are using today, so it stays exactly as it was.

start_webcam_overlay() {
  cleanup_webcam

  if [[ -z $WEBCAM_DEVICE ]]; then
    WEBCAM_DEVICE=$(omarchy-capture-webcam-list | sed -n '1s/[[:space:]].*//p')
    if [[ -z $WEBCAM_DEVICE ]]; then
      omarchy-notification-send -u critical -t 3000 "No webcam devices found"
      return 1
    fi
  fi

  local preferred_resolutions=("640x360" "1280x720" "1920x1080")
  local capture_options="framerate=30"
  local available_formats=$(v4l2-ctl --list-formats-ext -d "$WEBCAM_DEVICE" 2>/dev/null)

  for resolution in "${preferred_resolutions[@]}"; do
    if echo "$available_formats" | grep -q "$resolution"; then
      capture_options="video_size=$resolution,$capture_options"
      break
    fi
  done

  mpv "av://v4l2:$WEBCAM_DEVICE" \
    --profile=low-latency --untimed --no-cache \
    --demuxer-lavf-o="$capture_options" \
    '--vf=lavfi=[crop=ih*8/9:ih]' \
    --title="WebcamOverlay" --wayland-app-id="WebcamOverlay-$WEBCAM_SIZE" \
    --no-border --no-audio --no-osc --osd-level=0 \
    --really-quiet &>/dev/null &
  # Recorded like gsr: `pkill -f WebcamOverlay` reached any mpv whose argv contained
  # that string, including a second recording's overlay.
  omarchy-studio-procs record "$PROCS_FILE" webcam_overlay "$!" >/dev/null 2>&1

  # The move has to settle before gpu-screen-recorder starts, or the camera is
  # recorded sliding into its corner.
  local waited=0
  while ((waited < 40)) && ! hyprctl clients -j | jq -e 'any(.[]; .title == "WebcamOverlay")' >/dev/null 2>&1; do
    sleep 0.05
    ((waited++))
  done

  [[ ${1:-} == region:* ]] && echo "${1#region:}" >"$REGION_FILE"
  omarchy-capture-webcam-resize "$WEBCAM_SIZE"

  sleep 0.6
}

cleanup_webcam() {
  # Ours by pid. The pattern only when there was no state file at all -- NOT merely
  # when no overlay was recorded, which is the normal case for a take without a webcam
  # and which used to send `pkill -f WebcamOverlay` at the whole process table.
  if tracked_recording; then
    omarchy-studio-procs signal "$PROCS_FILE" SIGTERM webcam_overlay >/dev/null 2>&1
  elif legacy_fallback_ok; then
    pkill -u "$(id -u)" -f "WebcamOverlay" 2>/dev/null
  fi
  rm -f "$REGION_FILE"
}

# --- target selection --------------------------------------------------------

# Echoes "monitor:NAME" when the selection matches an entire monitor (prefer
# -w <monitor> over a region capture -- same kms backend, but no scaling math and full
# native res), otherwise "region:WxH+X+Y". Returns non-zero if the user cancelled.
select_capture_target() {
  local target
  target=$(omarchy-capture-region smart --match-monitor) || return 1

  if [[ $target == monitor:* ]]; then
    echo "$target"
    return
  fi

  [[ $target =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]] || return 1

  # gpu-screen-recorder wants region geometry in the compositor's logical coordinate
  # space -- the same space slurp returns -- so pass the values through untouched.
  echo "region:${BASH_REMATCH[3]}x${BASH_REMATCH[4]}+${BASH_REMATCH[1]}+${BASH_REMATCH[2]}"
}

# Resolves a target into MONITOR_NAME, MONITOR_SCALE and LOGICAL_GEOMETRY. The scale is
# read here, at record time, because it is unrecoverable afterwards: cursor events are
# logical and the video is physical, and a monitor rescaled between record and edit
# would silently double or halve every zoom focal point.
resolve_target_geometry() {
  local target=$1
  local monitors
  monitors=$(hyprctl monitors -j) || return 1

  local jq_logical='
    .transform as $t |
    { name: .name, scale: .scale, x: .x, y: .y,
      w: (if $t == 1 or $t == 3 then (.height / .scale | floor) else (.width / .scale | floor) end),
      h: (if $t == 1 or $t == 3 then (.width / .scale | floor) else (.height / .scale | floor) end) }'

  case $target in
  monitor:*)
    read -r MONITOR_NAME MONITOR_SCALE LOGICAL_GEOMETRY < <(
      jq -r --arg name "${target#monitor:}" \
        "first(.[] | select(.name == \$name) | $jq_logical) | \"\(.name) \(.scale) \(.w)x\(.h)+\(.x)+\(.y)\"" <<<"$monitors"
    )
    ;;
  region:*)
    [[ ${target#region:} =~ ^([0-9]+)x([0-9]+)\+(-?[0-9]+)\+(-?[0-9]+)$ ]] || return 1
    LOGICAL_GEOMETRY="${target#region:}"
    # The monitor under the region's centre owns the scale. A region straddling two
    # displays has no single answer, and the centre is the least surprising one.
    local cx=$((BASH_REMATCH[3] + BASH_REMATCH[1] / 2))
    local cy=$((BASH_REMATCH[4] + BASH_REMATCH[2] / 2))
    read -r MONITOR_NAME MONITOR_SCALE < <(
      jq -r --argjson cx "$cx" --argjson cy "$cy" \
        "[.[] | $jq_logical] | (first(.[] | select(\$cx >= .x and \$cx < .x + .w and \$cy >= .y and \$cy < .y + .h)) // .[0]) | \"\(.name) \(.scale)\"" <<<"$monitors"
    )
    ;;
  *) return 1 ;;
  esac

  [[ -n ${MONITOR_NAME:-} && -n ${MONITOR_SCALE:-} && -n ${LOGICAL_GEOMETRY:-} ]]
}

# Move a window clear of the capture rectangle, or say it cannot be done.
#
# WHY THIS EXISTS. `no_screen_share` only hides a window from the compositor's own
# screencopy/portal path. gpu-screen-recorder's KMS backend reads the DRM scanout BELOW
# the compositor, so on a KMS capture the rule does nothing at all -- verified by finding
# the teleprompter AND the recording HUD burned into a window recording, both of them
# carrying the rule and both plainly in the frames. A region capture at least leaves
# screen beside it, and putting the overlay there is the only way it stays off the take.
#
# Logical pixels throughout, which is what the hl.dsp dispatches take.
park_window_outside() {
  local title=$1 rect=$2
  [[ $rect =~ ^([0-9]+)x([0-9]+)\+(-?[0-9]+)\+(-?[0-9]+)$ ]] || return 1
  local rw=${BASH_REMATCH[1]} rh=${BASH_REMATCH[2]} rx=${BASH_REMATCH[3]} ry=${BASH_REMATCH[4]}

  local win
  win=$(hyprctl clients -j | jq -r --arg t "$title" \
    'first(.[] | select(.title == $t) | "\(.address) \(.size[0]) \(.size[1])") // empty')
  [[ -n $win ]] || return 1
  local address ww wh
  read -r address ww wh <<<"$win"

  # The monitor the capture sits on; the window has to stay somewhere visible.
  local mon
  mon=$(hyprctl monitors -j | jq -r --arg n "$MONITOR_NAME" \
    'first(.[] | select(.name == $n) | "\(.x) \(.y) \((.width / .scale) | floor) \((.height / .scale) | floor)") // empty')
  [[ -n $mon ]] || return 1
  local mx my mw mh
  read -r mx my mw mh <<<"$mon"

  local margin=16 nx="" ny=""
  # Below the capture first, then above, then right, then left: the bottom is where a
  # prompter is least in the way of what is being demonstrated.
  if ((my + mh - (ry + rh) >= wh + margin)); then
    nx=$((rx + (rw - ww) / 2)); ny=$((ry + rh + margin))
  elif ((ry - my >= wh + margin)); then
    nx=$((rx + (rw - ww) / 2)); ny=$((ry - wh - margin))
  elif ((mx + mw - (rx + rw) >= ww + margin)); then
    nx=$((rx + rw + margin)); ny=$((ry + (rh - wh) / 2))
  elif ((rx - mx >= ww + margin)); then
    nx=$((rx - ww - margin)); ny=$((ry + (rh - wh) / 2))
  else
    return 1
  fi
  ((nx < mx)) && nx=$mx
  ((nx + ww > mx + mw)) && nx=$((mx + mw - ww))

  hyprctl dispatch "hl.dsp.window.move({ x = $nx, y = $ny, window = \"address:$address\" })" >/dev/null 2>&1 ||
    hyprctl dispatch movewindowpixel "exact $nx $ny,address:$address" >/dev/null 2>&1
  return 0
}

# Everything that must not be in the take, once the backend is known. On the portal
# backend with the omarchy-studio-screenshare plugin the compositor keeps these out for us and
# they can stay where the user put them; on KMS nothing can, so they are moved or the
# user is told they will be recorded.
protect_overlays_from_capture() {
  local backend=$1 rect=$2
  # Only KMS needs this. The portal hides marked windows for us, and a toplevel
  # capture contains one window's surface tree and cannot see any other.
  [[ $backend == "kms" ]] || return 0

  local title stuck=()
  for title in "omarchy-studio-teleprompter"; do
    hyprctl clients -j | jq -e --arg t "$title" 'any(.[]; .title == $t)' >/dev/null 2>&1 || continue
    if park_window_outside "$title" "$rect"; then
      trail "overlay: moved $title clear of the capture (KMS cannot hide it)"
    else
      stuck+=("$title")
      trail "overlay: $title WILL BE RECORDED -- no room beside a KMS capture"
    fi
  done

  if ((${#stuck[@]})); then
    omarchy-notification-send -u critical -t 6000 "The teleprompter will be in this recording" \
      "This capture reads below the compositor, so it cannot be hidden, and there is no room beside the capture to move it."
  fi
}

# A self-view parked outside the capture: a region leaves room beside it, and a second
# monitor is always outside a monitor capture. KMS records as usual.
# Whether the bubble can sit OUTSIDE the capture, which is the only way KMS can have a
# live self-view at all.
#
# A region used to answer "yes" unconditionally, which is true of a small region and
# false of one that nearly fills its monitor -- and the second case is the common one.
# The recorder then chose `park`, the camera script looked for somewhere to put the
# bubble, found nothing, and dropped the self-view without saying so. Measured on the
# take that prompted this: a 2538x1384 region on a 2560x1440 monitor leaves 11px.
#
# The size test mirrors omarchy-capture-camera's find_park_spot deliberately -- same
# preset fractions, same margin. It is a duplicate, and the alternative is asking the
# camera script a question it has no mode to answer; if the presets there change, this
# has to follow, which is why both carry the numbers rather than one carrying a guess.
self_view_possible() {
  local target=$1
  if [[ $target != region:* ]]; then
    (($(hyprctl monitors -j | jq 'length') > 1))
    return
  fi

  [[ ${target#region:} =~ ^([0-9]+)x([0-9]+)\+(-?[0-9]+)\+(-?[0-9]+)$ ]] || return 1
  local rw=${BASH_REMATCH[1]} rh=${BASH_REMATCH[2]} rx=${BASH_REMATCH[3]} ry=${BASH_REMATCH[4]}

  local mon
  mon=$(hyprctl monitors -j 2>/dev/null | jq -r --arg n "$MONITOR_NAME" \
    'first(.[] | select(.name == $n) | "\(.x) \(.y) \((.width / .scale) | floor) \((.height / .scale) | floor)") // empty')
  [[ -n $mon ]] || return 1
  local mx my mw mh
  read -r mx my mw mh <<<"$mon"

  local preset
  case ${WEBCAM_SIZE:-medium} in
  small) preset=$((mh * 4 / 25)) ;;
  large) preset=$((mh * 3 / 10)) ;;
  *) preset=$((mh * 2 / 9)) ;;
  esac
  local need=$((preset + 80)) # the bubble plus find_park_spot's margin on both sides

  ((mx + mw - (rx + rw) >= need)) && return 0   # right
  ((rx - mx >= need)) && return 0               # left
  ((my + mh - (ry + rh) >= need)) && return 0   # below
  ((ry - my >= need)) && return 0               # above
  return 1
}

# The compositor can only keep a self-view out of the recording if something teaches it
# to leave no_screen_share windows OUT of portal frames rather than paint black boxes
# over them. Today that is the plugin in contrib/hyprland-studio-screenshare; it used to
# be an out-of-tree patch to Hyprland itself, whose config option is still accepted so a
# machine that has not been migrated keeps working. Stock Hyprland with neither answers
# no, and the fullscreen single-monitor case falls back to "no self-view" as before.
# Kept in lockstep with lib/omarchy_studio/compositor.py, which answers this for the HUD
# and the teleprompter.
self_view_exclusion_available() {
  [[ ${OMARCHY_SCREENRECORD_SELF_VIEW_EXCLUDE:-yes} != "no" ]] || return 1
  hyprctl -j plugin list 2>/dev/null | jq -e '.[] | select(.name == "omarchy-studio-screenshare")' >/dev/null 2>&1 && return 0
  [[ $(hyprctl getoption render:screenshare_exclude_windows 2>/dev/null | head -1) == "bool: true" ]]
}

# park    -- a spot outside the capture exists; KMS backend.
# exclude -- no such spot, but the compositor can hide the window from the portal, so it
#            sits inside the capture; portal backend (whole monitor only: a region that
#            leaves no room is not a thing, --match-monitor turns a full one into monitor:*).
# off     -- neither; the camera is still recorded, there is just no live preview.
# The bar, as absolute logical rectangles -- one per reserved edge that is non-zero.
#
# WHY THE RECORDER WORKS THIS OUT. The bar carries a recording indicator, and clicking
# it is how a take gets stopped. That click is real and lands in the recording, so
# auto-zoom would push in on the stop button as the final thing the viewer sees. The
# compositor knows where its own reserved area is; nothing downstream can work it out
# afterwards, so it is recorded now. See events.map_clicks.
chrome_rects_for_monitor() {
  hyprctl monitors -j 2>/dev/null | jq -r --arg n "$1" '
    .[] | select(.name == $n)
    | (.width / .scale | floor) as $w | (.height / .scale | floor) as $h
    | .reserved as $r
    | [ (if $r[0] > 0 then "\($w)x\($r[0])+\(.x)+\(.y)" else empty end),
        (if $r[1] > 0 then "\($w)x\($r[1])+\(.x)+\(.y + $h - $r[1])" else empty end),
        (if $r[2] > 0 then "\($r[2])x\($h)+\(.x)+\(.y)" else empty end),
        (if $r[3] > 0 then "\($r[3])x\($h)+\(.x + $w - $r[3])+\(.y)" else empty end) ]
    | .[]' 2>/dev/null
}

# The full logical rectangle of the monitor a capture sits on, as WxH+X+Y.
monitor_logical_geometry() {
  hyprctl monitors -j 2>/dev/null | jq -r --arg n "$MONITOR_NAME" \
    'first(.[] | select(.name == $n)
      | "\((.width / .scale) | floor)x\((.height / .scale) | floor)+\(.x)+\(.y)") // empty'
}

self_view_mode() {
  local target=$1
  [[ $WEBCAM == "true" && $BURN_IN != "true" ]] || {
    echo off
    return
  }
  if self_view_possible "$target"; then
    echo park
    return
  fi
  if [[ $target == monitor:* ]] && self_view_exclusion_available; then
    echo exclude
    return
  fi
  # A REGION can have one too, by recording the whole monitor through the portal and
  # cropping back at export. KMS is the only backend that can capture a sub-rectangle
  # directly, and KMS reads the scanout BELOW the compositor, so no_screen_share is
  # invisible to it and the bubble would be welded into every frame. The portal can hide
  # it but only ever hands over a whole monitor -- so we take the monitor and carve the
  # region out afterwards. macOS never faces this: it excludes windows on the same fast
  # path whatever the capture is.
  if [[ $target == region:* ]] && [[ -n $MONITOR_NAME ]] && self_view_exclusion_available; then
    echo exclude-crop
    return
  fi
  echo off
}

# The portal reports its buffer size before the first frame. It is accepted only when
# exactly one monitor has that physical size and it is the monitor we asked for: two
# identical monitors, or a picker choice that differs from the token, would otherwise
# put every cursor sample on the wrong screen. (Rotated outputs: untested -- the buffer
# may come transformed; a mismatch here refuses the recording rather than guessing.)
portal_geometry_matches() {
  local wanted=$1 size="" waited=0
  while ((waited < 100)); do
    size=$(sed -n 's/^gsr info: pipewire:[[:space:]]*Size: \([0-9]*x[0-9]*\).*/\1/p' "$GSR_STDERR" 2>/dev/null | tail -1)
    [[ -n $size ]] && break
    sleep 0.1
    ((waited++))
  done
  [[ -n $size ]] || {
    echo "portal: gsr never reported a pipewire buffer size" >>"$LOG_FILE"
    return 1
  }
  local matches
  matches=$(hyprctl monitors -j | jq -r --argjson w "${size%x*}" --argjson h "${size#*x}" \
    '[.[] | select(.width == $w and .height == $h) | .name] | join(" ")')
  echo "portal: buffer $size, monitors of that size: ${matches:-none}, wanted: $wanted" >>"$LOG_FILE"
  [[ $matches == "$wanted" ]]
}

# --- recording ---------------------------------------------------------------

GSR_PID=""
BUNDLE=""
RECORDING_LAUNCHED="false"

cleanup_start() {
  [[ $RECORDING_LAUNCHED == "true" ]] && return
  [[ -n $GSR_PID ]] && kill -INT "$GSR_PID" 2>/dev/null
  omarchy-capture-camera stop 2>/dev/null
  cleanup_webcam
  # A bundle whose media directory never received a frame is litter, not a recording.
  if [[ -n $BUNDLE && -d $BUNDLE ]] && [[ -z $(ls -A "$BUNDLE/media" 2>/dev/null) ]]; then
    rm -rf "$BUNDLE"
  fi
  rm -f "$BUNDLE_FILE"
}

start_screenrecording() {
  trap cleanup_start EXIT
  trap 'cleanup_start; exit 130' INT TERM HUP

  local target
  COUNTDOWN_SECONDS=0
  COUNTDOWN_UNTIL_US=0
  if [[ $FULLSCREEN == "true" ]]; then
    target="monitor:$(omarchy-hyprland-monitor-focused)"
  elif [[ $SETUP == "true" ]] && command -v omarchy-capture-setup >/dev/null; then
    # The setup bar is the default entry point: hotkey -> pick source, mic and camera ->
    # Record -> the bar destroys itself -> capture runs with nothing on screen. It prints
    # one line of JSON the MOMENT Record is pressed, specifically so gsr initialisation
    # happens inside the countdown rather than after it -- capture start can take
    # seconds, and making the user watch that after they already committed is the thing
    # the countdown exists to hide.
    local setup_json
    # OMARCHY_SETUP_ARGS is a test hook of the same class as the setup's own
    # --selftest-record: this handoff is the one part of the recording flow that cannot
    # be exercised without a person pressing Record, and it is also the place where a
    # failure is SILENT -- a non-zero setup returns from here with no notification at
    # all, which reads to the user as a recording that simply never happened.
    # shellcheck disable=SC2086
    trail "setup: opening the picker"
    setup_json=$(omarchy-capture-setup ${SETUP_COUNTDOWN:+--countdown "$SETUP_COUNTDOWN"} ${OMARCHY_SETUP_ARGS:-}) || {
      # Exit 1 is the documented "cancelled" answer, so this is usually the user pressing
      # Escape and must stay quiet. It is ALSO what a crashed picker looks like, which is
      # why it goes in the trail either way.
      trail "setup: exited non-zero (cancelled, or it crashed); nothing was recorded"
      return 1
    }
    [[ -n $setup_json ]] || {
      # Distinct from the above and never normal: the picker exited 0 and said nothing,
      # which no code path is supposed to produce. Silence here was read as "Record did
      # nothing", so it gets a notification of its own.
      trail "setup: exited 0 but printed no configuration; nothing was recorded"
      omarchy-notification-send -u critical -t 5000 "Screen recording did not start" \
        "The setup picker returned nothing. See $TRAIL_FILE"
      return 1
    }
    # Sampled the instant the contract line lands, which is the instant Record was
    # pressed: the countdown runs from here, and every setup surface is guaranteed gone
    # by the time it expires.
    local setup_done_us
    setup_done_us=$(monotonic_us)

    local setup_vars
    setup_vars=$(studio_capture setup --json "$setup_json") || {
      omarchy-notification-send -u critical -t 3000 "Screen recording error" "Could not read the setup selection"
      return 1
    }
    eval "$setup_vars"
    target="$TARGET"

    # The bar owns these choices now, so they override whatever the flags said.
    [[ $SETUP_MIC == "true" ]] && MICROPHONE_AUDIO="true" || MICROPHONE_AUDIO="false"
    [[ -n $SETUP_MIC_DEVICE ]] && MICROPHONE_DEVICE="$SETUP_MIC_DEVICE"
    [[ $SETUP_DESKTOP_AUDIO == "true" ]] && DESKTOP_AUDIO="true" || DESKTOP_AUDIO="false"
    if [[ $SETUP_CAMERA != "off" ]]; then
      WEBCAM="true"
      WEBCAM_SHAPE="$SETUP_CAMERA"
      [[ -n $SETUP_CAMERA_DEVICE ]] && WEBCAM_DEVICE="$SETUP_CAMERA_DEVICE"
    else
      WEBCAM="false"
    fi

    # Everything before the countdown expires contains the setup surfaces, which the
    # contract guarantees are destroyed by then. Those frames are recorded (we started
    # early on purpose) and simply not kept: trim_head_frames is already handled as a
    # leading cut by render.py, so events, layers and zoom all remap through the same
    # CutMap and nothing has to know this was a countdown rather than an edit.
    # A monotonic DEADLINE, not a duration: finalize compares it against gsr's
    # first-frame anchor, so however long capture took to produce that frame the trim
    # is still exactly the frames that could have contained a setup surface -- and zero
    # when the first frame arrived after the countdown had already ended.
    COUNTDOWN_SECONDS="$SETUP_COUNTDOWN_S"
    COUNTDOWN_UNTIL_US=$((setup_done_us + SETUP_COUNTDOWN_S * 1000000))
  else
    target=$(select_capture_target) || return 1
  fi

  resolve_target_geometry "$target" || {
    omarchy-notification-send -u critical -t 3000 "Screen recording error" "Could not resolve the capture geometry"
    return 1
  }

  local burned_in_flag=()
  [[ $WEBCAM == "true" && $BURN_IN == "true" ]] && burned_in_flag=(--burn-in)

  # Where the user left the self-view on the setup sheet. Seeds edit.json's webcam
  # placement so the camera opens in the editor exactly where it was placed, instead of
  # snapping back to the 0.72/0.70 defaults and making the placement look ignored.
  local camera_placement_args=()
  if [[ $WEBCAM == "true" && $BURN_IN != "true" && -n ${SETUP_CAMERA_RECT:-} ]]; then
    camera_placement_args=(--camera-rect "$SETUP_CAMERA_RECT"
                           --camera-shape "${SETUP_CAMERA:-circle}")
  fi

  local begin_output
  # Decided BEFORE the bundle is created: an `exclude-crop` region streams its whole
  # monitor, and capture.json has to record that from the outset -- it is the immutable
  # description of what the hardware did.
  local self_view_mode SOURCE_LOGICAL=""
  self_view_mode=$(self_view_mode "$target")
  if [[ $self_view_mode == "exclude-crop" ]]; then
    SOURCE_LOGICAL=$(monitor_logical_geometry)
    if [[ -z $SOURCE_LOGICAL ]]; then
      trail "self-view: no monitor geometry for $MONITOR_NAME; recording without one"
      self_view_mode="off"
    fi
  fi

  # ASKED FOR, never assumed. Recording the display and carrying the selection as a
  # crop is what makes the framing editable afterwards -- it is the only way a window
  # that moved can be followed, since gsr cannot capture a window on Wayland
  # (`-w window` is X11 only). But it also puts the whole screen on disk, and picking
  # one window is frequently a PRIVACY choice: everything beside it lands in the
  # bundle where an export can reach it. So it is a checkbox, defaulting to off, and
  # a plain selection records only the selection.
  #
  # Still KMS when it is on, so it costs disk rather than the portal's 30fps. The
  # portal is taken only when a self-view forces it, decided above.
  # Isolating a window is a different BACKEND, not a different rectangle, so it
  # settles before any of the framing questions: there is no crop, no monitor to
  # widen to, and nothing for the window track to be used for.
  local isolated="false"
  if [[ ${SETUP_WINDOW_ISOLATED:-false} == "true" && -n ${SETUP_WINDOW:-} ]]; then
    if [[ -x $WINDOW_RECORDER ]]; then
      isolated="true"
      SOURCE_LOGICAL=""
      # The self-view is a different window, and a toplevel capture contains exactly
      # one. So the bubble cannot be in the take wherever it sits -- no parking, no
      # portal, no compositor rule -- and the user's placement is honoured as-is.
      # A mode of its own rather than reusing "exclude", which would send the SCREEN
      # capture down the portal branch.
      [[ $self_view_mode != "off" ]] && self_view_mode="free"
    else
      trail "isolated: $WINDOW_RECORDER is not built; falling back to a rectangle capture"
      omarchy-notification-send -u normal -t 4000 "Recording the window's rectangle" \
        "The single-window recorder is not built, so anything overlapping the window will be in the take."
    fi
  fi

  if [[ $isolated == "false" && ${SETUP_FULL_MONITOR:-false} == "true" && -z $SOURCE_LOGICAL && $target == region:* ]]; then
    SOURCE_LOGICAL=$(monitor_logical_geometry)
    [[ -n $SOURCE_LOGICAL ]] ||
      trail "reframe: no monitor geometry for $MONITOR_NAME; recording the selection only"
  fi

  begin_output=$(studio_capture begin \
    --root "$OUTPUT_DIR/screenrecording-$(date +'%Y-%m-%d_%H-%M-%S')" \
    --logical "$LOGICAL_GEOMETRY" \
    --monitor "$MONITOR_NAME" \
    --scale "$MONITOR_SCALE" \
    ${SOURCE_LOGICAL:+--source-logical "$SOURCE_LOGICAL"} \
    $([[ $isolated == "true" ]] && echo --window-isolated) \
    $(chrome_rects_for_monitor "$MONITOR_NAME" | sed 's/^/--chrome-rect /') \
    "${burned_in_flag[@]}" "${camera_placement_args[@]}") || {
    trail "begin: FAILED to create the bundle"
    omarchy-notification-send -u critical -t 3000 "Screen recording error" "Could not create the recording bundle"
    return 1
  }

  local CAPTURE_SIZE="" CAPTURE_CODEC="" SOURCE_CROP=""
  eval "$begin_output"
  [[ -n $BUNDLE && -n $CAPTURE_SIZE ]] || return 1

  # gsr's -region flag is deprecated in 6.0.1; region geometry goes straight to -w.
  # Unless we are streaming more than the frame, in which case -w is the MONITOR and
  # the frame is carved back out at export, from SOURCE_CROP.
  local capture_w="${target#*:}"
  [[ -n $SOURCE_LOGICAL && -n $MONITOR_NAME ]] && capture_w="$MONITOR_NAME"
  local capture_args=(-w "$capture_w" -s "${RESOLUTION:-$CAPTURE_SIZE}")
  local capture_backend="kms" verbose_args=()
  [[ $isolated == "true" ]] && capture_backend="toplevel"
  local capture_fps="$FRAMERATE"
  if [[ $self_view_mode == "exclude" || $self_view_mode == "exclude-crop" ]]; then
    capture_backend="portal"
    mkdir -p "$(dirname "$PORTAL_TOKEN_FILE")"
    capture_args=(-w portal -restore-portal-session yes -portal-session-token-filepath "$PORTAL_TOKEN_FILE"
                  -s "${RESOLUTION:-$CAPTURE_SIZE}")
    verbose_args=(-v yes) # the "pipewire:    Size:" line portal_geometry_matches reads
    # 30, not 60, and this is a quality decision rather than a concession. Measured on
    # DP-1 at 5120x2880: a 60fps CFR master off the portal keeps only 50-83% of its
    # frames distinct depending on GPU load (KMS keeps 96-100%), so a third of what it
    # calls motion is duplicate frames -- which is what judder IS. At 30 the same path
    # keeps 98%. An honest 30 beats a 60 that is lying about half its frames.
    #
    # macOS recorders hold 60 and never face this: the OS excludes windows on the
    # same fast capture path, so a self-view costs them nothing. The trade-off is ours
    # alone, and copying their NUMBER would not copy their RESULT.
    [[ -z $FRAMERATE_EXPLICIT ]] && capture_fps=30
  fi

  [[ $WEBCAM == "true" && $BURN_IN == "true" ]] && start_webcam_overlay "$target"

  # gsr understands "default_output"/"default_input" as aliases; libavdevice's pulse
  # demuxer does NOT -- it accepts any name and quietly falls back to the default
  # SOURCE. So "record the desktop" recorded the microphone, with no error anywhere.
  # The toplevel recorder gets real PulseAudio names.
  resolve_pulse_alias() {
    case "$1" in
    default_output) local sink; sink=$(pactl get-default-sink 2>/dev/null) &&
                    [[ -n $sink ]] && echo "$sink.monitor" || echo "$1" ;;
    default_input)  pactl get-default-source 2>/dev/null || echo "$1" ;;
    *) echo "$1" ;;
    esac
  }

  # libavdevice's pulse demuxer accepts ANY name and falls back to the default
  # source, so a typo does not fail -- it records the microphone and says nothing.
  # The only place that can be caught is before it is handed over.
  pulse_source_exists() {
    pactl list short sources 2>/dev/null | cut -f2 | grep -Fxq "$1"
  }

  local audio_devices=""
  local audio_args=()
  [[ $DESKTOP_AUDIO == "true" ]] && audio_devices+="default_output"
  if [[ $MICROPHONE_AUDIO == "true" ]]; then
    # Merge audio tracks into one - separate tracks only play one at a time in most players
    [[ -n $audio_devices ]] && audio_devices+="|"
    # The picked source by name, or default_input when nothing was picked -- gsr
    # takes a PulseAudio source name in the same slot either way.
    audio_devices+="${MICROPHONE_DEVICE:-default_input}"
  fi
  [[ -n $audio_devices ]] && audio_args+=(-a "$audio_devices" -ac aac)

  local master="$BUNDLE/media/screen.mp4"
  rm -f "$IPC_SOCKET"

  echo "===== $(date '+%F %T') args: $SCRIPT_ARGS target: $target bundle: $BUNDLE backend: $capture_backend self-view: $self_view_mode =====" >>"$LOG_FILE"
  trail "start: $target backend=$capture_backend self-view=$self_view_mode bundle=$BUNDLE"
  protect_overlays_from_capture "$capture_backend" "$LOGICAL_GEOMETRY"
  : >"$GSR_STDERR"
  # -k: named, not auto. capture.capture_codec picks the codec that can encode the
  # panel's native grid, because `auto` would pick h264 on a display h264 cannot take
  # and the size would have to be halved to suit it.
  #
  # -cr full: gsr defaults to LIMITED range, which squeezes a desktop's 0-255 into
  # 16-235. Measured on the 2026-09-03 18:36 capture, which was tagged color_range=tv
  # with its luma sitting in 17-242: black backgrounds lifted off zero and white text
  # pulled off 255, i.e. every take shipped with its contrast quietly reduced. A desktop
  # is full-range source and there is no reason to record it as broadcast video.
  if [[ $isolated == "true" ]]; then
    # A different recorder entirely: hyprland_toplevel_export_v1 gives us the window's
    # own surface tree, so nothing drawn over it is in the frames and the capture
    # follows the window with no track. It speaks gsr's flag vocabulary deliberately.
    #
    # No -ipc: it has no control socket, and does not need one -- SIGTERM finalises the
    # file. The stop path already signals before it talks to the socket.
    local iso_audio=""
    if [[ -n $audio_devices ]]; then
      local part
      while IFS= read -r part; do
        [[ -z $part ]] && continue
        local resolved
        resolved=$(resolve_pulse_alias "$part")
        if ! pulse_source_exists "$resolved"; then
          trail "audio: no PulseAudio source named '$resolved'; recording without it"
          omarchy-notification-send -u normal -t 4000 "Audio source not found" \
            "Recording without '$resolved'."
          continue
        fi
        [[ -n $iso_audio ]] && iso_audio+="|"
        iso_audio+="$resolved"
      done < <(tr '|' '\n' <<<"$audio_devices")
    fi
    "$WINDOW_RECORDER" -w "$SETUP_WINDOW" \
      -k "${CAPTURE_CODEC:-auto}" -f "$capture_fps" \
      -cursor "$CURSOR_CAPTURE" \
      ${iso_audio:+-a "$iso_audio"} \
      -write-first-frame-ts "$master.ts" \
      -o "$master" 2> >(tee -a "$GSR_STDERR" >>"$LOG_FILE") &
  else
  gpu-screen-recorder "${capture_args[@]}" \
    -k "${CAPTURE_CODEC:-auto}" -cr full -f "$capture_fps" -fm cfr -fallback-cpu-encoding yes \
    -cursor "$CURSOR_CAPTURE" \
    -write-first-frame-ts yes \
    -ipc "$IPC_SOCKET" "${verbose_args[@]}" \
    -o "$master" "${audio_args[@]}" 2> >(tee -a "$GSR_STDERR" >>"$LOG_FILE") &
  fi
  GSR_PID=$!
  # Identity recorded now, while we still know it. Verified at stop as (pid, start
  # time), so a recycled pid cannot be mistaken for this process.
  omarchy-studio-procs record "$PROCS_FILE" gsr "$GSR_PID" "$BUNDLE" >/dev/null 2>&1

  # On the portal backend this wait also covers the share picker the first time round.
  while kill -0 $GSR_PID 2>/dev/null && [[ ! -f $master ]]; do
    sleep 0.2
  done
  kill -0 $GSR_PID 2>/dev/null || return 1

  if [[ $capture_backend == "portal" ]] && ! portal_geometry_matches "$MONITOR_NAME"; then
    kill -INT "$GSR_PID" 2>/dev/null
    omarchy-notification-send -u critical -t 4000 "Screen recording error" \
      "The portal did not hand over $MONITOR_NAME (see $GSR_STDERR)"
    return 1
  fi

  # The camera is a separate stream so the editor can move, resize or remove it. Its
  # offset against the screen is measured per recording from the two anchors: launch
  # order plus per-pipeline warm-up (KMS 128-137ms, V4L2 210-228ms) is not a constant.
  if [[ $WEBCAM == "true" && $BURN_IN != "true" ]]; then
    local camera_args=(--size="$WEBCAM_SIZE" --shape="$WEBCAM_SHAPE"
                       --outside="$LOGICAL_GEOMETRY")
    [[ -n $WEBCAM_DEVICE ]] && camera_args+=(--device="$WEBCAM_DEVICE")
    # Where the user actually left the bubble in the setup bar. The camera process
    # honours it whenever the compositor is hiding the self-view from the capture, and
    # parks instead when it is not -- on KMS an honoured rect is a bubble welded into
    # the take. Either way the EXPORT composites the camera here, because the same
    # rectangle went into edit.json above.
    [[ -n ${SETUP_CAMERA_RECT:-} ]] && camera_args+=(--rect="$SETUP_CAMERA_RECT")
    case $self_view_mode in
    park) camera_args+=(--self-view=yes) ;;
    # Nothing to hide from: the capture is one window and this is not it.
    free) camera_args+=(--self-view=yes --exclude=yes) ;;
    # Both hide the bubble in the compositor; exclude-crop additionally streams the
    # whole monitor and carves the region out at export.
    exclude | exclude-crop) camera_args+=(--self-view=yes --exclude=yes) ;;
    *) camera_args+=(--self-view=no) ;;
    esac
    if omarchy-capture-camera start "$BUNDLE" "${camera_args[@]}"; then
      trail "camera: started ($self_view_mode self-view)"
      # Worth its own line because it looks like a bug from the user's chair: they
      # placed the bubble, and Record moved it. On KMS nothing can hide a window from
      # the capture, so a bubble left inside the frame would be welded into it -- the
      # live one is moved clear and the EXPORT still composites the camera where they
      # put it, from the same rectangle that went into edit.json.
      [[ $self_view_mode == "park" && -n ${SETUP_CAMERA_RECT:-} ]] &&
        trail "camera: placement $SETUP_CAMERA_RECT not honoured live (KMS cannot hide the bubble); the export still uses it"
    else
      trail "camera: FAILED to start; the screen recording continues without it"
      omarchy-notification-send -u critical -t 3000 "Webcam not recorded" "The screen recording is running without it"
    fi
  fi

  # Built by another part of the system; a missing event daemon costs auto-zoom and the
  # synthetic cursor, not the recording. The scale goes with it because events are
  # logical pixels and the video is physical -- the daemon cannot read it off the
  # compositor later without risking a different answer than the one in capture.json.
  if command -v omarchy-capture-input-events >/dev/null; then
    local window_args=()
    # Only a window pick has an address, and the track is only USEFUL when the
    # display was recorded: without surrounding pixels there is nowhere to pan to,
    # and a track nothing can act on would put an inert toggle in the editor.
    [[ -n ${SETUP_WINDOW:-} && -n $SOURCE_LOGICAL ]] && window_args=(--window="$SETUP_WINDOW")
    omarchy-capture-input-events start "$BUNDLE/events" --scale="$MONITOR_SCALE" "${window_args[@]}" >>"$LOG_FILE" 2>&1 ||
      echo "input events failed to start" >>"$LOG_FILE"
  fi

  echo "$BUNDLE" >"$BUNDLE_FILE"
  echo "$master" >"$RECORDING_FILE"
  # Written even when it is 0, so a stale deadline from a previous run can never be
  # read by a recording that had no countdown at all.
  echo "$COUNTDOWN_UNTIL_US" >"$COUNTDOWN_FILE"
  RECORDING_LAUNCHED="true"

  # The on-screen controls (spec 1c). Detached, because it has to outlive this script
  # exactly as the recording does, and because its Stop button re-enters this same
  # script -- a HUD in this process group would be taken down by its own stop.
  # It declines to start where the compositor cannot keep it out of the capture, which
  # is the right answer: a Stop button burned into every frame is a re-shoot.
  setsid omarchy-recording-hud --socket "$IPC_SOCKET" --bundle "$BUNDLE" \
    --mic-device "${MICROPHONE_DEVICE:-}" \
    ${capture_backend:+--backend "$capture_backend"} \
    ${LOGICAL_GEOMETRY:+--capture-rect "$LOGICAL_GEOMETRY"} \
    ${MONITOR_NAME:+--monitor "$MONITOR_NAME"} >>"$LOG_FILE" 2>&1 </dev/null &
  # setsid, so $! is the session leader rather than the HUD itself -- record it anyway:
  # what matters is that the pid is verified before it is signalled.
  omarchy-studio-procs record "$PROCS_FILE" hud "$!" >/dev/null 2>&1

  # Nothing watched gsr once it was backgrounded and this script returned, so if it
  # died -- crash, kill, a stop that missed it -- the camera ffmpeg and the event
  # daemon kept running. The camera holds /dev/video0, so the symptom is a webcam
  # light that stays on long after the recording ended, with cam.mp4 growing to
  # gigabytes beside a screen.mp4 that stopped minutes ago. Observed: a 77MB cam.mp4
  # still growing next to a 1.1MB screen.mp4 two minutes stale.
  #
  # Detached on purpose: it has to outlive this script, which returns immediately.
  # Both stops are idempotent, so racing the normal stop path costs nothing.
  setsid bash -c '
    while kill -0 '"$GSR_PID"' 2>/dev/null; do sleep 1; done
    omarchy-capture-camera stop >/dev/null 2>&1
    command -v omarchy-capture-input-events >/dev/null &&
      omarchy-capture-input-events stop >/dev/null 2>&1
  ' >/dev/null 2>&1 < /dev/null &
  toggle_screenrecording_indicator

  # Run from a terminal this backgrounds a recorder and returns, which on its own is
  # indistinguishable from having crashed -- especially when the only output was a
  # warning about the self-view. The bar indicator alone is not enough feedback for
  # someone who is looking at their prompt, so say it plainly and say how to stop.
  if [[ -t 1 ]]; then
    local what="${target#monitor:}"
    [[ $target == region:* ]] && what="region ${target#region:}"
    echo "Recording $what -> $BUNDLE"
    [[ $capture_backend == "portal" ]] && echo "  backend: portal (self-view inside the capture, kept out of it by the compositor)"
    [[ $capture_backend == "toplevel" ]] && echo "  backend: toplevel (this window's own pixels; nothing drawn over it is in the take)"
    [[ $WEBCAM == "true" && $BURN_IN != "true" ]] && echo "  camera: media/cam.mp4, separate stream (movable in the editor)"
    echo "  stop:   Alt+PrintScreen, the bar indicator, or run this command again"
  fi
}

# The prompter that came WITH this recording goes with it. One the user raised for
# themselves stays: they are the only one who knows whether they are done reading.
stop_owned_teleprompter() {
  local pid
  pid=$(cat "$PROMPTER_OWNED_FILE" 2>/dev/null) || return 0
  [[ -n $pid ]] || return 0
  # The pid is CHECKED before it is signalled. This marker can outlive the process that
  # wrote it -- a setup killed outright leaves it behind -- and pids get reused, so a
  # stale marker is a loaded gun pointed at whatever process inherits that number.
  # Observed: cancelling the picker left the file holding a dead pid.
  if [[ -r /proc/$pid/cmdline ]] &&
    tr '\0' ' ' </proc/"$pid"/cmdline 2>/dev/null | grep -q "omarchy-teleprompter"; then
    kill "$pid" 2>/dev/null
    trail "teleprompter: closed (it was raised by this recording)"
  else
    trail "teleprompter: stale ownership marker for pid $pid; left alone"
  fi
  rm -f "$PROMPTER_OWNED_FILE"
  return 0
}

stop_recording_hud() {
  # The pid is CHECKED before it is signalled, the way stop_owned_teleprompter has
  # always done it. This one did not: `kill $(cat pidfile)` on a marker that can outlive
  # the process that wrote it, aimed at whatever process later inherits that number.
  # Two identical hazards in one file, one guarded and one not.
  if tracked_recording; then
    omarchy-studio-procs signal "$PROCS_FILE" SIGTERM hud >/dev/null 2>&1
  fi
  local pid
  pid=$(cat "$HUD_PID_FILE" 2>/dev/null) || { rm -f "$HUD_PID_FILE"; return 0; }
  if [[ -n $pid && -r /proc/$pid/cmdline ]] &&
    tr '\0' ' ' </proc/"$pid"/cmdline 2>/dev/null | grep -q "omarchy-recording-hud"; then
    kill "$pid" 2>/dev/null
  fi
  rm -f "$HUD_PID_FILE"
  return 0
}

stop_screenrecording() {
  local bundle
  bundle=$(cat "$BUNDLE_FILE" 2>/dev/null)

  # 'stop' is answered only once the file is finalized (136ms after a 6s recording), so
  # the reply is the completion signal. SIGINT remains the fallback for a recording this
  # script did not start -- an older build's, say -- which has no socket.
  if [[ -n $bundle && -S $IPC_SOCKET ]]; then
    # 30s was chosen for the finalize wait on a long recording, but it is also how long
    # this blocks when the socket exists and gsr is not yet answering on it -- which is
    # exactly the "started it, immediately realised I picked the wrong window, hit stop"
    # case. Ask briefly, then fall through to the signal, which gsr honours whatever
    # state it is in. A finalize that needs longer is still waited for below, by the
    # process-exit loop, so nothing is truncated by asking impatiently.
    omarchy-studio-ipc "$IPC_SOCKET" stop --timeout 5 >/dev/null || {
      interrupt_recorder
    }
  else
    interrupt_recorder # SIGINT required to save video properly
  fi

  # This, not the IPC reply, is what guarantees the file is closed. 30s: a 4K finalize
  # is well under a second, but an encoder flushing a long recording under load is not,
  # and killing early is how a video gets truncated.
  if omarchy-studio-procs pids "$PROCS_FILE" gsr >/dev/null 2>&1; then
    omarchy-studio-procs wait "$PROCS_FILE" 30 gsr >/dev/null 2>&1
  else
    local count=0
    while pgrep -u "$(id -u)" -f "^gpu-screen-recorder" >/dev/null && ((count < 300)); do
      sleep 0.1
      count=$((count + 1))
    done
  fi

  omarchy-capture-camera stop
  # After gsr is down, not before: the HUD's own Stop runs this script, so taking it
  # away first would kill the thing that is still waiting for the file to finalize.
  stop_recording_hud
  stop_owned_teleprompter
  command -v omarchy-capture-input-events >/dev/null &&
    omarchy-capture-input-events stop >/dev/null 2>&1
  toggle_screenrecording_indicator
  cleanup_webcam

  if recorder_still_up; then
    if tracked_recording; then
      omarchy-studio-procs signal "$PROCS_FILE" SIGKILL gsr >/dev/null 2>&1
    else
      pkill -u "$(id -u)" -9 -f "^gpu-screen-recorder"
    fi
    omarchy-notification-send -u critical -t 5000 "Screen recording error" "Recording process had to be force-killed. Video may be corrupted."
    rm -f "$RECORDING_FILE" "$BUNDLE_FILE"
    omarchy-studio-procs clear "$PROCS_FILE" >/dev/null 2>&1
    return
  fi

  local master
  master=$(cat "$RECORDING_FILE" 2>/dev/null)

  if [[ -n $bundle && -d $bundle ]]; then
    local camera_args=()
    [[ -f $bundle/media/cam.mp4 ]] && camera_args=(--camera media/cam.mp4)
    local trim_args=() countdown_until_us
    countdown_until_us=$(cat "$COUNTDOWN_FILE" 2>/dev/null)
    [[ ${countdown_until_us:-0} =~ ^[0-9]+$ ]] && ((countdown_until_us > 0)) &&
      trim_args=(--trim-until-monotonic-us "$countdown_until_us")
    # stdout is inspected rather than discarded: finalize now distinguishes "the
    # manifest failed" (fatal, the bundle will not open) from "the camera track did not
    # survive" (the screen recording is fine and editable, minus the camera), and those
    # two deserve different things said to the user.
    local finalize_out
    if finalize_out=$(studio_capture finalize --root "$bundle" "${camera_args[@]}" "${trim_args[@]}" 2>>"$LOG_FILE"); then
      echo "$finalize_out" >>"$LOG_FILE"
      if [[ $finalize_out == *CAMERA_UNREADABLE=* ]]; then
        omarchy-notification-send -u critical -t 5000 "Webcam track was lost" \
          "The screen recording is fine and will open in the editor; only the camera is missing."
      fi
    else
      omarchy-notification-send -u critical -t 5000 "Screen recording error" \
        "The media was saved but capture.json could not be completed: $bundle"
    fi
    master="$bundle/media/screen.mp4"
  fi

  trail "stopped: $master"
  echo "$master"
  announce_recording "$master"
  rm -f "$RECORDING_FILE" "$BUNDLE_FILE" "$COUNTDOWN_FILE"
  # Cleared last: a stale set would make the next `screenrecording_active` say a
  # recording is running and turn the next keypress into a stop.
  omarchy-studio-procs clear "$PROCS_FILE" >/dev/null 2>&1
}

announce_recording() {
  local master=$1
  [[ -f $master ]] || return

  # The thumbnail comes out of the master and never back into it: the master is read-only
  # from the moment gsr closes it, and media/ holds nothing that was not captured.
  local preview
  if [[ $master == */media/screen.mp4 ]]; then
    preview="${master%/media/screen.mp4}/.preview.png"
  else
    preview="${master%.mp4}-preview.png"
  fi
  ffmpeg -y -i "$master" -ss 00:00:00.1 -vframes 1 -q:v 2 "$preview" -loglevel quiet 2>/dev/null

  # A deliberate stop leads straight into the editor (docs/design/spec.md, Decisions):
  # pressing stop is a decision, and editing is the thing you wanted next. Any other
  # ending -- a hotkey from another workspace, disk pressure, crash recovery -- has no
  # such intent behind it, so it only posts a notification whose action opens the editor.
  local bundle_dir=""
  [[ $master == */media/screen.mp4 ]] && bundle_dir="${master%/media/screen.mp4}"

  trail "announce: bundle=${bundle_dir:-none} deliberate=$STOPPED_DELIBERATELY editor=$(command -v omarchy-studio >/dev/null && echo yes || echo no)"
  if [[ -n $bundle_dir && $STOPPED_DELIBERATELY == "true" ]] && command -v omarchy-studio >/dev/null; then
    omarchy-notification-send "Screen recording saved" "Opening the editor" \
      -t 4000 --image "${preview:-$master}"
    # setsid so the editor outlives the shell that stopped the recording -- otherwise
    # closing the terminal takes the window with it.
    setsid omarchy-studio "$bundle_dir" >/dev/null 2>&1 &
    trail "announce: launched the editor (pid $!)"
  elif [[ -n $bundle_dir ]] && command -v omarchy-studio >/dev/null; then
    omarchy-notification-send "Screen recording saved" "Click to edit" \
      -t 10000 --image "${preview:-$master}" \
      --exec omarchy-studio -- "$bundle_dir"
  else
    omarchy-notification-send "Screen recording saved" "Open with Super + Alt + , (or click this)" \
      -t 10000 --image "${preview:-$master}" \
      --exec mpv -- "$master"
  fi

  # The shell loads the thumbnail into memory when the toast appears and never re-reads
  # the file, so the preview only has to outlive that load -- not the toast.
  (
    sleep 2
    rm -f "$preview"
  ) &
}

toggle_screenrecording_indicator() {
  omarchy-shell -q omarchy.indicators refresh
}

# Whether THIS recording was tracked. The distinction that matters is "was there a
# state file", not "did the supervisor have anything to signal": those are different
# questions and conflating them is what made the pattern fall back during NORMAL
# operation rather than only for an old build.
#
# It cost a shell to find out. Stopping a --fullscreen take signalled webcam_overlay,
# which was legitimately absent (no webcam), the `||` fired, and `pkill -f
# "WebcamOverlay"` killed the terminal that ran it -- because that terminal's own
# command line happened to contain the string. Which is the entire argument against
# pattern-matched process control, delivered by the code it was being removed from.
tracked_recording() {
  [[ -f $PROCS_FILE ]]
}

# Whether the pattern fallbacks may run at all. They exist for ONE case -- a recording
# started by a build that predates the state file -- and that case is only possible if
# a recorder is actually running while no state file exists. Idle is not that case: the
# state file is removed at the end of every stop, so a cancelled start (Escape at the
# picker, a failed launch) reached cleanup with no state file and fell straight through
# to `pkill -f WebcamOverlay` against the whole process table. That matched, in testing,
# an editor holding a file whose NAME contained the string.
legacy_fallback_ok() {
  ! tracked_recording && pgrep -u "$(id -u)" -f "^gpu-screen-recorder" >/dev/null
}

# SIGINT, to the process this recording actually started. gsr needs SIGINT rather than
# SIGTERM to finalise its file. The pattern is only for a recording started by a build
# that predates the state file -- without it, upgrading mid-recording would leave a take
# nothing could stop.
interrupt_recorder() {
  if tracked_recording; then
    omarchy-studio-procs signal "$PROCS_FILE" SIGINT gsr >/dev/null 2>&1
  else
    pkill -u "$(id -u)" -SIGINT -f "^gpu-screen-recorder"
  fi
}

recorder_still_up() {
  if tracked_recording; then
    omarchy-studio-procs pids "$PROCS_FILE" gsr >/dev/null 2>&1
  else
    pgrep -u "$(id -u)" -f "^gpu-screen-recorder" >/dev/null
  fi
}

screenrecording_active() {
  recorder_still_up
}

if screenrecording_active; then
  STOPPED_DELIBERATELY="true"
  stop_screenrecording
elif [[ $STOP_RECORDING == "true" ]]; then
  exit 1
else
  start_screenrecording
fi
