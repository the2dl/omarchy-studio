#!/bin/bash

# omarchy:summary=Start or stop screen recording
# omarchy:group=capture
# omarchy:args=[--fullscreen] [--with-desktop-audio] [--with-microphone-audio] [--with-webcam] [--burn-in] [--webcam-device=<device>] [--webcam-size=<small|medium|large>] [--resolution=<size>] [--stop-recording]
# omarchy:examples=omarchy screenrecord | omarchy capture screenrecording --with-webcam
# omarchy:aliases=omarchy screenrecord
#
# A recording is a bundle directory, not a file: the screen, the camera and the input
# events are captured as separate streams beside an immutable capture.json, so the
# webcam can be moved, the zoom retimed and sections cut long after the fact. See
# lib/omarchy_studio/project.py for the layout.
#
# Nothing here re-encodes or trims the master. The old finalize step (-ss 0.1 plus
# loudnorm, then mv over the original) is gone -- overwriting the capture is exactly
# what a non-destructive pipeline cannot do, and the -100ms shift it applied silently
# invalidated the first-frame anchor everything else is timed against. Loudness
# normalization now happens at export, where it can be turned off again.
#
# Env: OMARCHY_SCREENRECORD_DEBUG=true appends gpu-screen-recorder's stderr to
# /tmp/omarchy-screenrecord.log.
#
# OMARCHY_SCREENRECORD_USE_PORTAL is gone. The portal backend never reports which
# rectangle of which monitor it handed over, and capture.json cannot be written without
# it: every cursor sample is a logical coordinate that has to be mapped into the video,
# and guessing the origin puts the zoom focal point somewhere else entirely. HDR and
# external-GPU captures need the portal to publish its geometry before they can come
# back.

set -uo pipefail

STUDIO_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PATH="$STUDIO_ROOT/bin:$PATH"

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${OMARCHY_SCREENRECORD_DIR:-${XDG_VIDEOS_DIR:-$HOME/Videos}}"

if [[ ! -d $OUTPUT_DIR ]]; then
  omarchy-notification-send -u critical -t 3000 "Screen recording directory does not exist: $OUTPUT_DIR"
  exit 1
fi

DESKTOP_AUDIO="false"
MICROPHONE_AUDIO="false"
WEBCAM="false"
BURN_IN="false"
WEBCAM_DEVICE=""
WEBCAM_SIZE="medium"
RESOLUTION=""
FULLSCREEN="false"
STOP_RECORDING="false"
# The setup bar is the default way in. --no-setup drops straight to the legacy slurp
# picker, which is what --fullscreen and scripted callers want.
SETUP="true"
SETUP_COUNTDOWN=""
COUNTDOWN_SECONDS=0
# True when a person asked for the stop, as opposed to the recorder ending some other
# way. Only a deliberate stop opens the editor unprompted.
STOPPED_DELIBERATELY="false"
SCRIPT_ARGS="$*"

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
RECORDING_FILE="/tmp/omarchy-screenrecord-filename"
BUNDLE_FILE="$RUNTIME_DIR/omarchy-studio-bundle"
IPC_SOCKET="$RUNTIME_DIR/omarchy-studio-gsr.sock"
REGION_FILE="$RUNTIME_DIR/omarchy-screenrecord-region"
LOG_FILE=$([[ ${OMARCHY_SCREENRECORD_DEBUG:-false} == "true" ]] && echo "/tmp/omarchy-screenrecord.log" || echo "/dev/null")

# The one place cursor capture is decided. gsr burns the cursor into the frame and
# magnifies it softly under zoom; the fix is a synthetic cursor rendered from the event
# track at export, and until that exists a cursorless recording is the worse regression.
# Flip to "no" here, and only here, when it lands.
CURSOR_CAPTURE="yes"

STUDIO_PYTHON="${OMARCHY_STUDIO_PYTHON:-$STUDIO_ROOT/.venv/bin/python}"
[[ -x $STUDIO_PYTHON ]] || STUDIO_PYTHON="python3"

studio_capture() {
  PYTHONPATH="$STUDIO_ROOT/lib${PYTHONPATH:+:$PYTHONPATH}" "$STUDIO_PYTHON" -m omarchy_studio.capture "$@"
}

for arg in "$@"; do
  case "$arg" in
  --with-desktop-audio) DESKTOP_AUDIO="true" ;;
  --with-microphone-audio) MICROPHONE_AUDIO="true" ;;
  --with-webcam) WEBCAM="true" ;;
  --burn-in) BURN_IN="true" ;;
  --webcam-device=*) WEBCAM_DEVICE="${arg#*=}" ;;
  --webcam-size=*) WEBCAM_SIZE="${arg#*=}" ;;
  --resolution=*) RESOLUTION="${arg#*=}" ;;
  --fullscreen) FULLSCREEN="true" ;;
  --no-setup) SETUP="false" ;;
  --countdown=*) SETUP_COUNTDOWN="${arg#*=}" ;;
  --stop-recording) STOP_RECORDING="true" ;;
  esac
done

case $WEBCAM_SIZE in
small | medium | large) ;;
*)
  echo "Invalid webcam size: $WEBCAM_SIZE (expected small, medium, or large)" >&2
  exit 1
  ;;
esac

# --- the burned-in camera path (unchanged behaviour) -------------------------
#
# An mpv overlay inside the captured region, recorded as pixels. Nothing in the editor
# can move or remove it afterwards, which is why it is not the default -- but it is what
# people are using today, so it stays exactly as it was.

start_webcam_overlay() {
  cleanup_webcam

  if [[ -z $WEBCAM_DEVICE ]]; then
    WEBCAM_DEVICE=$(omarchy-capture-webcam-list | sed -n '1s/[[:space:]].*//p')
    if [[ -z $WEBCAM_DEVICE ]]; then
      omarchy-notification-send -u critical -t 3000 "No webcam devices found"
      return 1
    fi
  fi

  local preferred_resolutions=("640x360" "1280x720" "1920x1080")
  local capture_options="framerate=30"
  local available_formats=$(v4l2-ctl --list-formats-ext -d "$WEBCAM_DEVICE" 2>/dev/null)

  for resolution in "${preferred_resolutions[@]}"; do
    if echo "$available_formats" | grep -q "$resolution"; then
      capture_options="video_size=$resolution,$capture_options"
      break
    fi
  done

  mpv "av://v4l2:$WEBCAM_DEVICE" \
    --profile=low-latency --untimed --no-cache \
    --demuxer-lavf-o="$capture_options" \
    '--vf=lavfi=[crop=ih*8/9:ih]' \
    --title="WebcamOverlay" --wayland-app-id="WebcamOverlay-$WEBCAM_SIZE" \
    --no-border --no-audio --no-osc --osd-level=0 \
    --really-quiet &>/dev/null &

  # The move has to settle before gpu-screen-recorder starts, or the camera is
  # recorded sliding into its corner.
  local waited=0
  while ((waited < 40)) && ! hyprctl clients -j | jq -e 'any(.[]; .title == "WebcamOverlay")' >/dev/null 2>&1; do
    sleep 0.05
    ((waited++))
  done

  [[ ${1:-} == region:* ]] && echo "${1#region:}" >"$REGION_FILE"
  omarchy-capture-webcam-resize "$WEBCAM_SIZE"

  sleep 0.6
}

cleanup_webcam() {
  pkill -f "WebcamOverlay" 2>/dev/null
  rm -f "$REGION_FILE"
}

# --- target selection --------------------------------------------------------

# Echoes "monitor:NAME" when the selection matches an entire monitor (prefer
# -w <monitor> over a region capture -- same kms backend, but no scaling math and full
# native res), otherwise "region:WxH+X+Y". Returns non-zero if the user cancelled.
select_capture_target() {
  local target
  target=$(omarchy-capture-region smart --match-monitor) || return 1

  if [[ $target == monitor:* ]]; then
    echo "$target"
    return
  fi

  [[ $target =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]] || return 1

  # gpu-screen-recorder wants region geometry in the compositor's logical coordinate
  # space -- the same space slurp returns -- so pass the values through untouched.
  echo "region:${BASH_REMATCH[3]}x${BASH_REMATCH[4]}+${BASH_REMATCH[1]}+${BASH_REMATCH[2]}"
}

# Resolves a target into MONITOR_NAME, MONITOR_SCALE and LOGICAL_GEOMETRY. The scale is
# read here, at record time, because it is unrecoverable afterwards: cursor events are
# logical and the video is physical, and a monitor rescaled between record and edit
# would silently double or halve every zoom focal point.
resolve_target_geometry() {
  local target=$1
  local monitors
  monitors=$(hyprctl monitors -j) || return 1

  local jq_logical='
    .transform as $t |
    { name: .name, scale: .scale, x: .x, y: .y,
      w: (if $t == 1 or $t == 3 then (.height / .scale | floor) else (.width / .scale | floor) end),
      h: (if $t == 1 or $t == 3 then (.width / .scale | floor) else (.height / .scale | floor) end) }'

  case $target in
  monitor:*)
    read -r MONITOR_NAME MONITOR_SCALE LOGICAL_GEOMETRY < <(
      jq -r --arg name "${target#monitor:}" \
        "first(.[] | select(.name == \$name) | $jq_logical) | \"\(.name) \(.scale) \(.w)x\(.h)+\(.x)+\(.y)\"" <<<"$monitors"
    )
    ;;
  region:*)
    [[ ${target#region:} =~ ^([0-9]+)x([0-9]+)\+(-?[0-9]+)\+(-?[0-9]+)$ ]] || return 1
    LOGICAL_GEOMETRY="${target#region:}"
    # The monitor under the region's centre owns the scale. A region straddling two
    # displays has no single answer, and the centre is the least surprising one.
    local cx=$((BASH_REMATCH[3] + BASH_REMATCH[1] / 2))
    local cy=$((BASH_REMATCH[4] + BASH_REMATCH[2] / 2))
    read -r MONITOR_NAME MONITOR_SCALE < <(
      jq -r --argjson cx "$cx" --argjson cy "$cy" \
        "[.[] | $jq_logical] | (first(.[] | select(\$cx >= .x and \$cx < .x + .w and \$cy >= .y and \$cy < .y + .h)) // .[0]) | \"\(.name) \(.scale)\"" <<<"$monitors"
    )
    ;;
  *) return 1 ;;
  esac

  [[ -n ${MONITOR_NAME:-} && -n ${MONITOR_SCALE:-} && -n ${LOGICAL_GEOMETRY:-} ]]
}

# A self-view can only be shown where the capture cannot see it. gsr has no exclusion
# flag and Hyprland has no hide-from-capture rule -- verified, there is no software
# trick -- so a fullscreen capture on the only monitor gets no self-view at all.
self_view_possible() {
  local target=$1
  [[ $target == region:* ]] && return 0
  (($(hyprctl monitors -j | jq 'length') > 1))
}

# --- recording ---------------------------------------------------------------

GSR_PID=""
BUNDLE=""
RECORDING_LAUNCHED="false"

cleanup_start() {
  [[ $RECORDING_LAUNCHED == "true" ]] && return
  [[ -n $GSR_PID ]] && kill -INT "$GSR_PID" 2>/dev/null
  omarchy-capture-camera stop 2>/dev/null
  cleanup_webcam
  # A bundle whose media directory never received a frame is litter, not a recording.
  if [[ -n $BUNDLE && -d $BUNDLE ]] && [[ -z $(ls -A "$BUNDLE/media" 2>/dev/null) ]]; then
    rm -rf "$BUNDLE"
  fi
  rm -f "$BUNDLE_FILE"
}

start_screenrecording() {
  trap cleanup_start EXIT
  trap 'cleanup_start; exit 130' INT TERM HUP

  local target
  COUNTDOWN_SECONDS=0
  if [[ $FULLSCREEN == "true" ]]; then
    target="monitor:$(omarchy-hyprland-monitor-focused)"
  elif [[ $SETUP == "true" ]] && command -v omarchy-capture-setup >/dev/null; then
    # The setup bar is the default entry point: hotkey -> pick source, mic and camera ->
    # Record -> the bar destroys itself -> capture runs with nothing on screen. It prints
    # one line of JSON the MOMENT Record is pressed, specifically so gsr initialisation
    # happens inside the countdown rather than after it -- capture start can take
    # seconds, and making the user watch that after they already committed is the thing
    # the countdown exists to hide.
    local setup_json
    setup_json=$(omarchy-capture-setup ${SETUP_COUNTDOWN:+--countdown "$SETUP_COUNTDOWN"}) || return 1
    [[ -n $setup_json ]] || return 1

    local setup_vars
    setup_vars=$(studio_capture setup --json "$setup_json") || {
      omarchy-notification-send -u critical -t 3000 "Screen recording error" "Could not read the setup selection"
      return 1
    }
    eval "$setup_vars"
    target="$TARGET"

    # The bar owns these choices now, so they override whatever the flags said.
    [[ $SETUP_MIC == "true" ]] && MICROPHONE_AUDIO="true" || MICROPHONE_AUDIO="false"
    [[ $SETUP_DESKTOP_AUDIO == "true" ]] && DESKTOP_AUDIO="true" || DESKTOP_AUDIO="false"
    if [[ $SETUP_CAMERA != "off" ]]; then
      WEBCAM="true"
      [[ -n $SETUP_CAMERA_DEVICE ]] && WEBCAM_DEVICE="$SETUP_CAMERA_DEVICE"
    else
      WEBCAM="false"
    fi

    # Everything before the countdown expires contains the setup surfaces, which the
    # contract guarantees are destroyed by then. Those frames are recorded (we started
    # early on purpose) and simply not kept: trim_head_frames is already handled as a
    # leading cut by render.py, so events, layers and zoom all remap through the same
    # CutMap and nothing has to know this was a countdown rather than an edit.
    # Seconds, not frames: the real fps is not known until finalize probes the file,
    # and multiplying by an assumed 60 here would silently mistrim every 30fps capture.
    COUNTDOWN_SECONDS="$SETUP_COUNTDOWN_S"
  else
    target=$(select_capture_target) || return 1
  fi

  resolve_target_geometry "$target" || {
    omarchy-notification-send -u critical -t 3000 "Screen recording error" "Could not resolve the capture geometry"
    return 1
  }

  local burned_in_flag=()
  [[ $WEBCAM == "true" && $BURN_IN == "true" ]] && burned_in_flag=(--burn-in)

  local begin_output
  begin_output=$(studio_capture begin \
    --root "$OUTPUT_DIR/screenrecording-$(date +'%Y-%m-%d_%H-%M-%S')" \
    --logical "$LOGICAL_GEOMETRY" \
    --monitor "$MONITOR_NAME" \
    --scale "$MONITOR_SCALE" \
    "${burned_in_flag[@]}") || {
    omarchy-notification-send -u critical -t 3000 "Screen recording error" "Could not create the recording bundle"
    return 1
  }

  local CAPTURE_SIZE=""
  eval "$begin_output"
  [[ -n $BUNDLE && -n $CAPTURE_SIZE ]] || return 1

  # gsr's -region flag is deprecated in 6.0.1; region geometry goes straight to -w.
  local capture_args=(-w "${target#*:}" -s "${RESOLUTION:-$CAPTURE_SIZE}")

  [[ $WEBCAM == "true" && $BURN_IN == "true" ]] && start_webcam_overlay "$target"

  local audio_devices=""
  local audio_args=()
  [[ $DESKTOP_AUDIO == "true" ]] && audio_devices+="default_output"
  if [[ $MICROPHONE_AUDIO == "true" ]]; then
    # Merge audio tracks into one - separate tracks only play one at a time in most players
    [[ -n $audio_devices ]] && audio_devices+="|"
    audio_devices+="default_input"
  fi
  [[ -n $audio_devices ]] && audio_args+=(-a "$audio_devices" -ac aac)

  local master="$BUNDLE/media/screen.mp4"
  rm -f "$IPC_SOCKET"

  echo "===== $(date '+%F %T') args: $SCRIPT_ARGS target: $target bundle: $BUNDLE =====" >>"$LOG_FILE"
  gpu-screen-recorder "${capture_args[@]}" \
    -k auto -f 60 -fm cfr -fallback-cpu-encoding yes \
    -cursor "$CURSOR_CAPTURE" \
    -write-first-frame-ts yes \
    -ipc "$IPC_SOCKET" \
    -o "$master" "${audio_args[@]}" 2>>"$LOG_FILE" &
  GSR_PID=$!

  while kill -0 $GSR_PID 2>/dev/null && [[ ! -f $master ]]; do
    sleep 0.2
  done
  kill -0 $GSR_PID 2>/dev/null || return 1

  # The camera is a separate stream so the editor can move, resize or remove it. Its
  # offset against the screen is measured per recording from the two anchors: launch
  # order plus per-pipeline warm-up (KMS 128-137ms, V4L2 210-228ms) is not a constant.
  if [[ $WEBCAM == "true" && $BURN_IN != "true" ]]; then
    local camera_args=(--size="$WEBCAM_SIZE" --outside="$LOGICAL_GEOMETRY")
    [[ -n $WEBCAM_DEVICE ]] && camera_args+=(--device="$WEBCAM_DEVICE")
    if self_view_possible "$target"; then
      camera_args+=(--self-view=yes)
    else
      camera_args+=(--self-view=no)
    fi
    omarchy-capture-camera start "$BUNDLE" "${camera_args[@]}" ||
      omarchy-notification-send -u critical -t 3000 "Webcam not recorded" "The screen recording is running without it"
  fi

  # Built by another part of the system; a missing event daemon costs auto-zoom and the
  # synthetic cursor, not the recording. The scale goes with it because events are
  # logical pixels and the video is physical -- the daemon cannot read it off the
  # compositor later without risking a different answer than the one in capture.json.
  if command -v omarchy-capture-input-events >/dev/null; then
    omarchy-capture-input-events start "$BUNDLE/events" --scale="$MONITOR_SCALE" >>"$LOG_FILE" 2>&1 ||
      echo "input events failed to start" >>"$LOG_FILE"
  fi

  echo "$BUNDLE" >"$BUNDLE_FILE"
  echo "$master" >"$RECORDING_FILE"
  RECORDING_LAUNCHED="true"
  toggle_screenrecording_indicator

  # Run from a terminal this backgrounds a recorder and returns, which on its own is
  # indistinguishable from having crashed -- especially when the only output was a
  # warning about the self-view. The bar indicator alone is not enough feedback for
  # someone who is looking at their prompt, so say it plainly and say how to stop.
  if [[ -t 1 ]]; then
    local what="${target#monitor:}"
    [[ $target == region:* ]] && what="region ${target#region:}"
    echo "Recording $what -> $BUNDLE"
    [[ $WEBCAM == "true" && $BURN_IN != "true" ]] && echo "  camera: media/cam.mp4, separate stream (movable in the editor)"
    echo "  stop:   Alt+PrintScreen, the bar indicator, or run this command again"
  fi
}

stop_screenrecording() {
  local bundle
  bundle=$(cat "$BUNDLE_FILE" 2>/dev/null)

  # 'stop' is answered only once the file is finalized (136ms after a 6s recording), so
  # the reply is the completion signal. SIGINT remains the fallback for a recording this
  # script did not start -- an older build's, say -- which has no socket.
  if [[ -n $bundle && -S $IPC_SOCKET ]]; then
    # 30s was chosen for the finalize wait on a long recording, but it is also how long
    # this blocks when the socket exists and gsr is not yet answering on it -- which is
    # exactly the "started it, immediately realised I picked the wrong window, hit stop"
    # case. Ask briefly, then fall through to the signal, which gsr honours whatever
    # state it is in. A finalize that needs longer is still waited for below, by the
    # process-exit loop, so nothing is truncated by asking impatiently.
    omarchy-studio-ipc "$IPC_SOCKET" stop --timeout 5 >/dev/null || {
      pkill -SIGINT -f "^gpu-screen-recorder"
    }
  else
    pkill -SIGINT -f "^gpu-screen-recorder" # SIGINT required to save video properly
  fi

  # This, not the IPC reply, is what guarantees the file is closed. 30s: a 4K finalize
  # is well under a second, but an encoder flushing a long recording under load is not,
  # and killing early is how a video gets truncated.
  local count=0
  while pgrep -f "^gpu-screen-recorder" >/dev/null && ((count < 300)); do
    sleep 0.1
    count=$((count + 1))
  done

  omarchy-capture-camera stop
  command -v omarchy-capture-input-events >/dev/null &&
    omarchy-capture-input-events stop >/dev/null 2>&1
  toggle_screenrecording_indicator
  cleanup_webcam

  if pgrep -f "^gpu-screen-recorder" >/dev/null; then
    pkill -9 -f "^gpu-screen-recorder"
    omarchy-notification-send -u critical -t 5000 "Screen recording error" "Recording process had to be force-killed. Video may be corrupted."
    rm -f "$RECORDING_FILE" "$BUNDLE_FILE"
    return
  fi

  local master
  master=$(cat "$RECORDING_FILE" 2>/dev/null)

  if [[ -n $bundle && -d $bundle ]]; then
    local camera_args=()
    [[ -f $bundle/media/cam.mp4 ]] && camera_args=(--camera media/cam.mp4)
    local trim_args=()
    ((COUNTDOWN_SECONDS > 0)) && trim_args=(--trim-head-seconds "$COUNTDOWN_SECONDS")
    if ! studio_capture finalize --root "$bundle" "${camera_args[@]}" "${trim_args[@]}" >>"$LOG_FILE" 2>&1; then
      omarchy-notification-send -u critical -t 5000 "Screen recording error" \
        "The media was saved but capture.json could not be completed: $bundle"
    fi
    master="$bundle/media/screen.mp4"
  fi

  echo "$master"
  announce_recording "$master"
  rm -f "$RECORDING_FILE" "$BUNDLE_FILE"
}

announce_recording() {
  local master=$1
  [[ -f $master ]] || return

  # The thumbnail comes out of the master and never back into it: the master is read-only
  # from the moment gsr closes it, and media/ holds nothing that was not captured.
  local preview
  if [[ $master == */media/screen.mp4 ]]; then
    preview="${master%/media/screen.mp4}/.preview.png"
  else
    preview="${master%.mp4}-preview.png"
  fi
  ffmpeg -y -i "$master" -ss 00:00:00.1 -vframes 1 -q:v 2 "$preview" -loglevel quiet 2>/dev/null

  # A deliberate stop leads straight into the editor (docs/design/spec.md, Decisions):
  # pressing stop is a decision, and editing is the thing you wanted next. Any other
  # ending -- a hotkey from another workspace, disk pressure, crash recovery -- has no
  # such intent behind it, so it only posts a notification whose action opens the editor.
  local bundle_dir=""
  [[ $master == */media/screen.mp4 ]] && bundle_dir="${master%/media/screen.mp4}"

  if [[ -n $bundle_dir && $STOPPED_DELIBERATELY == "true" ]] && command -v omarchy-studio >/dev/null; then
    omarchy-notification-send "Screen recording saved" "Opening the editor" \
      -t 4000 --image "${preview:-$master}"
    # setsid so the editor outlives the shell that stopped the recording -- otherwise
    # closing the terminal takes the window with it.
    setsid omarchy-studio "$bundle_dir" >/dev/null 2>&1 &
  elif [[ -n $bundle_dir ]] && command -v omarchy-studio >/dev/null; then
    omarchy-notification-send "Screen recording saved" "Click to edit" \
      -t 10000 --image "${preview:-$master}" \
      --exec omarchy-studio -- "$bundle_dir"
  else
    omarchy-notification-send "Screen recording saved" "Open with Super + Alt + , (or click this)" \
      -t 10000 --image "${preview:-$master}" \
      --exec mpv -- "$master"
  fi

  # The shell loads the thumbnail into memory when the toast appears and never re-reads
  # the file, so the preview only has to outlive that load -- not the toast.
  (
    sleep 2
    rm -f "$preview"
  ) &
}

toggle_screenrecording_indicator() {
  omarchy-shell -q omarchy.indicators refresh
}

screenrecording_active() {
  pgrep -f "^gpu-screen-recorder" >/dev/null
}

if screenrecording_active; then
  STOPPED_DELIBERATELY="true"
  stop_screenrecording
elif [[ $STOP_RECORDING == "true" ]]; then
  exit 1
else
  start_screenrecording
fi
